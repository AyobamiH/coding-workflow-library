{
  "name": "autonomous-coding-workflow-library",
  "version": "0.2.2",
  "description": "Autonomous coding workflow skills library for local agent orchestration.",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AyobamiH/coding-workflow-library.git"
  },
  "homepage": "https://github.com/AyobamiH/coding-workflow-library#readme",
  "bugs": {
    "url": "https://github.com/AyobamiH/coding-workflow-library/issues"
  },
  "bin": {
    "coding-workflow": "bin/coding-workflow.js"
  },
  "keywords": [
    "codex",
    "skills",
    "workflow",
    "automation"
  ],
  "scripts": {
    "check:js": "node scripts/check-js",
    "check:paths": "node scripts/check-public-paths",
    "test": "npm run check:js && npm run check:paths && node tests/lane-state.test.js && node tests/objective-authority.test.js && node tests/autonomous-boundaries.test.js && node tests/pipeline-diagnostics.test.js && node tests/run-next-resume.test.js && node tests/workflow-extraction.test.js && node tests/docs-list.test.js && node tests/repo-map.test.js && node tests/project-kb.test.js && node tests/pre-commit-check.test.js && node tests/migration-review.test.js && node tests/browser-live-proof.test.js && node tests/github-deep-review.test.js && node tests/public-paths.test.js && node scripts/docs-list --validate && node scripts/repo-map --repo . --validate && node scripts/project-kb --repo . --validate && node scripts/migration-review --repo . --validate && node scripts/route-audit && node scripts/validate-skills",
    "validate": "node scripts/validate-skills",
    "cleaner": "node scripts/skill-cleaner",
    "routes": "node scripts/route-audit",
    "route:audit": "node scripts/route-audit",
    "docs:list": "node scripts/docs-list",
    "docs:validate": "node scripts/docs-list --validate",
    "repo:map": "node scripts/repo-map --repo .",
    "repo:validate": "node scripts/repo-map --repo . --validate",
    "project:kb": "node scripts/project-kb --repo .",
    "project:kb:validate": "node scripts/project-kb --repo . --validate",
    "migration:review": "node scripts/migration-review --repo .",
    "migration:validate": "node scripts/migration-review --repo . --validate",
    "browser:proof": "node scripts/browser-live-proof",
    "github:deep-review": "node scripts/github-deep-review",
    "precommit": "node scripts/pre-commit-check",
    "precommit:full": "node scripts/pre-commit-check --full",
    "hooks:install": "node scripts/install-git-hooks",
    "readiness": "node scripts/library-packaging-readiness --repo .",
    "readiness:open-source": "node scripts/library-packaging-readiness --repo . --expect-open-source",
    "readiness:npm": "node scripts/library-packaging-readiness --repo . --expect-npm",
    "readiness:cli": "node scripts/library-packaging-readiness --repo . --expect-cli",
    "package:readiness": "node scripts/npm-package-readiness --repo . --expect-package --expect-cli",
    "release:preflight": "node scripts/release-preflight --repo . --mode cli",
    "release:preflight:cli": "node scripts/release-preflight --repo . --mode cli --allow-pack-dry-run",
    "pack:dry-run": "npm pack --dry-run --json",
    "check": "npm test && npm run package:readiness && npm run release:preflight",
    "prepack": "npm test"
  },
  "files": [
    "AGENTS.md",
    "bin/",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-DECISION.md",
    "package-lock.json",
    "README.md",
    "RUNBOOK.md",
    "build-queue.md",
    "command-library.md",
    "docs/",
    "evidence-checklist.md",
    "routes/",
    "schemas/",
    "runs/",
    "scripts/",
    "state/",
    "skill-files/",
    "skills-index.md",
    "templates/",
    "tests/",
    "tool-patterns.md",
    "tools.md",
    "work-ledger.md"
  ]
}
