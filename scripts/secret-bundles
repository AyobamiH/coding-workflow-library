#!/usr/bin/env node

const { main } = require("./lib/secret-bundles/cli");

main(process.argv.slice(2)).catch((error) => {
  // Runtime errors are intentionally reduced to stable codes. Provider stderr,
  // decrypted values, and private absolute paths must never cross this boundary.
  console.error(error && error.safeCode ? error.safeCode : "SECRET_BUNDLES_FAILED");
  process.exit(error && Number.isInteger(error.exitCode) ? error.exitCode : 1);
});
