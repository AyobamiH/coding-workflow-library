#!/usr/bin/env node

const fs = require("fs");
const path = require("path");
const { spawnSync } = require("child_process");

const ROOT = path.resolve(__dirname, "..");

const SECRET_PATTERNS = [
  { category: "github-token", regex: /\bgh[pousr]_[A-Za-z0-9_]{12,}\b/g },
  { category: "openai-style-token", regex: /\bsk-[A-Za-z0-9_-]{12,}\b/g },
  { category: "jwt", regex: /\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b/g },
  { category: "bearer-token", regex: /\bBearer\s+[A-Za-z0-9._~+/=-]{12,}\b/gi },
  { category: "database-url", regex: /\bpostgres(?:ql)?:\/\/[^\s'")]+/gi },
  { category: "private-key", regex: /-----BEGIN [A-Z ]*PRIVATE KEY-----/g },
];

const SECRET_ASSIGNMENT = /\b([A-Z][A-Z0-9_]*(?:SECRET|TOKEN|PASSWORD|PRIVATE_KEY|SERVICE_ROLE_KEY|DATABASE_URL|DB_URL|API_KEY)[A-Z0-9_]*)\s*[:=]\s*["']?([A-Za-z0-9_./+=:@-]{12,})["']?/;

function usage() {
  console.log(`Usage:
  ./scripts/pre-commit-check [--staged] [--full] [--json]

Run deterministic local checks before committing this library.

Modes:
  default   Fast checks: whitespace, JS syntax, docs-list, repo-map, project-kb, routes, skills.
  --staged  Also inspect the staged diff for unsafe whitespace and secret-shaped additions.
  --full    Include npm test and advisory skill-cleaner.
  --json    Print structured output without raw command logs.

This helper does not install dependencies, stage files, commit, push, publish, deploy,
read secret values, call production endpoints, or mutate product repositories.`);
}

function parseArgs(argv) {
  const args = {
    repo: process.cwd(),
    full: false,
    json: false,
    staged: false,
    help: false,
  };

  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--repo") {
      args.repo = argv[++index];
      if (!args.repo) throw new Error("--repo requires a path");
    } else if (arg === "--full") {
      args.full = true;
    } else if (arg === "--json") {
      args.json = true;
    } else if (arg === "--staged") {
      args.staged = true;
    } else if (arg === "--help" || arg === "-h") {
      args.help = true;
    } else {
      throw new Error(`unknown argument: ${arg}`);
    }
  }

  return args;
}

function run(command, args, options = {}) {
  return spawnSync(command, args, {
    cwd: options.cwd,
    env: { ...process.env, NO_COLOR: "1" },
    encoding: "utf8",
    maxBuffer: 1024 * 1024 * 16,
  });
}

function git(repo, args) {
  return run("git", ["-C", repo, ...args], { cwd: repo });
}

function isGitRepo(repo) {
  return git(repo, ["rev-parse", "--is-inside-work-tree"]).status === 0;
}

function isPlaceholder(value) {
  const normalized = String(value || "").trim().replace(/^['"]|['"]$/g, "").toLowerCase();
  if (!normalized) return true;
  if (/^<[^>]+>$/.test(normalized)) return true;
  return [
    "example",
    "placeholder",
    "your-secret-here",
    "your_secret_here",
    "replace-me",
    "replace_me",
    "set-in-provider",
    "set_in_provider",
  ].includes(normalized);
}

function redact(text, repo = ROOT) {
  let output = String(text || "");
  const repoPath = path.resolve(repo);
  if (repoPath && repoPath !== path.parse(repoPath).root) {
    output = output.split(repoPath).join("<repo>");
  }
  output = output.replace(/\/home\/[^/\s]+\/\.openclaw\/[^\s'")]+/g, "<private-path>");
  output = output.replace(/(GH_TOKEN|GITHUB_TOKEN|SUPABASE_ACCESS_TOKEN|IMPORT_REDDIT_TIPS_SECRET|DATABASE_URL|SUPABASE_DB_URL)=\S+/g, "$1=<redacted>");
  for (const pattern of SECRET_PATTERNS) {
    output = output.replace(pattern.regex, `<redacted:${pattern.category}>`);
  }
  return output;
}

function commandLabel(command, args) {
  if (command === process.execPath) return `node ${args.join(" ")}`;
  return [command, ...args].join(" ");
}

function checkResult(id, status, extra = {}) {
  return {
    id,
    status,
    message: extra.message || "",
    command: extra.command || null,
    output: extra.output || "",
    risks: extra.risks || [],
  };
}

function buildDefaultChecks(options = {}) {
  const checks = [
    { id: "git-diff-check", command: "git", args: ["diff", "--check"] },
    { id: "syntax-cli", command: process.execPath, args: ["--check", "bin/coding-workflow.js"] },
    { id: "syntax-run-next", command: process.execPath, args: ["--check", "scripts/run-next"] },
    { id: "syntax-docs-list", command: process.execPath, args: ["--check", "scripts/docs-list"] },
    { id: "syntax-repo-map", command: process.execPath, args: ["--check", "scripts/repo-map"] },
    { id: "syntax-project-kb", command: process.execPath, args: ["--check", "scripts/project-kb"] },
    { id: "syntax-migration-review", command: process.execPath, args: ["--check", "scripts/migration-review"] },
    { id: "syntax-browser-live-proof", command: process.execPath, args: ["--check", "scripts/browser-live-proof"] },
    { id: "public-paths", command: process.execPath, args: ["scripts/check-public-paths"] },
    { id: "docs-list-validate", command: process.execPath, args: ["scripts/docs-list", "--validate"] },
    { id: "repo-map-validate", command: process.execPath, args: ["scripts/repo-map", "--repo", ".", "--validate"] },
    { id: "project-kb-validate", command: process.execPath, args: ["scripts/project-kb", "--repo", ".", "--validate"] },
    { id: "migration-review-validate", command: process.execPath, args: ["scripts/migration-review", "--repo", ".", "--validate"] },
    { id: "route-audit", command: process.execPath, args: ["scripts/route-audit"] },
    { id: "validate-skills", command: process.execPath, args: ["scripts/validate-skills"] },
  ];

  if (options.full) {
    checks.push(
      { id: "npm-test", command: "npm", args: ["test"] },
      { id: "skill-cleaner", command: process.execPath, args: ["scripts/skill-cleaner"] },
    );
  }

  return checks;
}

function executeCommandCheck(repo, check) {
  if (check.id === "git-diff-check" && !isGitRepo(repo)) {
    return checkResult(check.id, "skipped", {
      command: commandLabel(check.command, check.args),
      message: "not a Git repository",
    });
  }
  const result = check.command === "git"
    ? git(repo, check.args)
    : run(check.command, check.args, { cwd: repo });
  const output = redact(`${result.stdout || ""}${result.stderr || ""}`.trim(), repo);
  if (result.status === 0) {
    return checkResult(check.id, "passed", {
      command: commandLabel(check.command, check.args),
      output,
    });
  }
  return checkResult(check.id, "failed", {
    command: commandLabel(check.command, check.args),
    message: `exit ${typeof result.status === "number" ? result.status : 1}`,
    output,
  });
}

function stagedFiles(repo) {
  const result = git(repo, ["diff", "--cached", "--name-only"]);
  if (result.status !== 0) {
    return { ok: false, files: [], output: redact(`${result.stdout || ""}${result.stderr || ""}`, repo) };
  }
  return {
    ok: true,
    files: result.stdout.split(/\r?\n/).filter(Boolean).sort((a, b) => a.localeCompare(b)),
    output: "",
  };
}

function scanAddedLine(content, file, lineNumber) {
  const risks = [];
  const assignment = content.match(SECRET_ASSIGNMENT);
  if (assignment && !isPlaceholder(assignment[2])) {
    risks.push({
      file,
      line: lineNumber,
      category: `secret-assignment:${assignment[1]}`,
    });
  }
  for (const pattern of SECRET_PATTERNS) {
    pattern.regex.lastIndex = 0;
    if (pattern.regex.test(content)) {
      risks.push({ file, line: lineNumber, category: pattern.category });
    }
  }
  return risks;
}

function scanDiffForSecrets(diffText) {
  const risks = [];
  let file = null;
  let lineNumber = 0;

  for (const line of String(diffText || "").split(/\r?\n/)) {
    if (line.startsWith("+++ b/")) {
      file = line.slice("+++ b/".length);
      continue;
    }
    const hunk = line.match(/^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@/);
    if (hunk) {
      lineNumber = Number(hunk[1]) || 0;
      continue;
    }
    if (line.startsWith("+") && !line.startsWith("+++")) {
      risks.push(...scanAddedLine(line.slice(1), file || "unknown", lineNumber || null));
      lineNumber += 1;
    } else if (!line.startsWith("-") && !line.startsWith("@@")) {
      lineNumber += 1;
    }
  }

  return risks;
}

function inspectStaged(repo) {
  const names = stagedFiles(repo);
  if (!names.ok) {
    return checkResult("staged-files", "failed", {
      message: "could not inspect staged files",
      output: names.output,
    });
  }
  if (!names.files.length) {
    return checkResult("staged-diff-safety", "skipped", {
      message: "no staged files",
    });
  }

  const diffCheck = git(repo, ["diff", "--cached", "--check"]);
  if (diffCheck.status !== 0) {
    return checkResult("staged-diff-check", "failed", {
      message: "staged whitespace/conflict-marker check failed",
      output: redact(`${diffCheck.stdout || ""}${diffCheck.stderr || ""}`, repo),
    });
  }

  const diff = git(repo, ["diff", "--cached", "--unified=0", "--no-ext-diff"]);
  if (diff.status !== 0) {
    return checkResult("staged-secret-scan", "failed", {
      message: "could not inspect staged diff",
      output: redact(`${diff.stdout || ""}${diff.stderr || ""}`, repo),
    });
  }

  const risks = scanDiffForSecrets(diff.stdout);
  if (risks.length) {
    return checkResult("staged-secret-scan", "failed", {
      message: "secret-shaped staged addition found; values redacted",
      risks,
    });
  }

  return checkResult("staged-secret-scan", "passed", {
    message: `${names.files.length} staged file(s) inspected`,
  });
}

function classifyRepo(repo) {
  const rootCheck = git(repo, ["rev-parse", "--show-toplevel"]);
  return {
    root: ".",
    classification: path.resolve(repo) === ROOT ? "coding-workflow-library" : "git-repository",
    git_root_found: rootCheck.status === 0,
  };
}

function summarize(checks, options, repo) {
  const failed = checks.filter((check) => check.status === "failed");
  const skipped = checks.filter((check) => check.status === "skipped");
  const passed = checks.filter((check) => check.status === "passed");
  return {
    status: failed.length ? "fail" : "pass",
    mode: {
      full: Boolean(options.full),
      staged: Boolean(options.staged),
    },
    repo: classifyRepo(repo),
    checks_run: checks.length,
    passed: passed.length,
    failed: failed.length,
    skipped: skipped.length,
    first_failure: failed.length ? {
      id: failed[0].id,
      message: failed[0].message || "check failed",
    } : null,
    checks,
    duration_ms: 0,
  };
}

function runPreCommitCheck(options = {}) {
  const repo = path.resolve(options.repo || process.cwd());
  const checks = [];

  if (options.staged) {
    checks.push(inspectStaged(repo));
    if (checks[checks.length - 1].status === "failed") {
      return summarize(checks, options, repo);
    }
  }

  const plan = Array.isArray(options.checkPlan) ? options.checkPlan : buildDefaultChecks(options);
  for (const check of plan) {
    const result = executeCommandCheck(repo, check);
    checks.push(result);
    if (result.status === "failed") break;
  }

  return summarize(checks, options, repo);
}

function printHuman(report) {
  console.log("# Pre-Commit Check\n");
  console.log(`Status: ${report.status.toUpperCase()}`);
  console.log(`Mode: ${report.mode.staged ? "staged" : "default"}${report.mode.full ? " + full" : ""}`);
  console.log(`Checks: ${report.passed} passed, ${report.failed} failed, ${report.skipped} skipped`);
  for (const check of report.checks) {
    const suffix = check.message ? ` - ${check.message}` : "";
    console.log(`- ${check.status.toUpperCase()}: ${check.id}${suffix}`);
    if (check.status === "failed" && check.risks.length) {
      for (const risk of check.risks) {
        const line = risk.line ? `:${risk.line}` : "";
        console.log(`  risk: ${risk.file}${line} (${risk.category})`);
      }
    } else if (check.status === "failed" && check.output) {
      console.log(check.output);
    }
  }
}

function main() {
  let args;
  try {
    args = parseArgs(process.argv.slice(2));
  } catch (error) {
    console.error(error.message);
    usage();
    process.exit(2);
  }

  if (args.help) {
    usage();
    return;
  }

  const report = runPreCommitCheck(args);
  if (args.json) {
    console.log(JSON.stringify(report, null, 2));
  } else {
    printHuman(report);
  }
  process.exit(report.status === "pass" ? 0 : 1);
}

if (require.main === module) {
  main();
}

module.exports = {
  buildDefaultChecks,
  inspectStaged,
  redact,
  runPreCommitCheck,
  scanDiffForSecrets,
};
