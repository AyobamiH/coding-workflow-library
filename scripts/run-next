  console.log(`Usage:
  ./scripts/run-next
  ./scripts/run-next --dry-run
  ./scripts/run-next --doctor
  ./scripts/run-next --explain
  ./scripts/run-next --explain-boundary PRODUCTION_MUTATION_APPROVAL
  ./scripts/run-next --list-approvals
  ./scripts/run-next --repo /path/to/repo --status
  ./scripts/run-next --repo /path/to/repo --resume --dry-run
  ./scripts/run-next --repo /path/to/repo --resume --allow <permission>
  ./scripts/run-next --list-routes
