const LIBRARY_ROOT = path.resolve(__dirname, "..");
const DEFAULT_REPO = process.cwd();
const DEFAULT_RUNTIME_ROOT = path.resolve(
  process.env.CODING_WORKFLOW_HOME || path.join(os.homedir(), ".openclaw"),
