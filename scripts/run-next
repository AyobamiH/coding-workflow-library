const DEFAULT_ENV_FILE = path.resolve(
  process.env.CODING_WORKFLOW_ENV_FILE || path.join(DEFAULT_RUNTIME_ROOT, ".env"),
);
const DEFAULT_TEMP_ROOT = path.resolve(
  process.env.CODING_WORKFLOW_TMPDIR || path.join(os.tmpdir(), "coding-workflow-library"),
);
const DEFAULT_NPM_CACHE = path.resolve(
  process.env.CODING_WORKFLOW_NPM_CACHE || path.join(DEFAULT_TEMP_ROOT, "npm-cache"),
);
const EXPECTED_GITHUB_REPO = "AyobamiH/wagging-web-wins";
