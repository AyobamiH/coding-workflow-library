let loadedRuntimeApi = null;

function runtimeApi() {
  if (loadedRuntimeApi) return loadedRuntimeApi;

  runtimeContext.configure({
    fs,
    os,
    path,
    laneState,
    objectiveAuthority,
    autonomousBoundaries,
    LIBRARY_ROOT,
    DEFAULT_REPO,
    DEFAULT_RUNTIME_ROOT,
    DEFAULT_ENV_FILE,
    DEFAULT_TEMP_ROOT,
    DEFAULT_NPM_CACHE,
    EXPECTED_GITHUB_REPO,
    EXPECTED_GITHUB_USER,
    FEATURE_BRANCH,
    SCHEDULER_BRANCH,
    EXPECTED_COMMIT,
    EXPECTED_COMMIT_SUBJECT,
    PR_TITLE,
    SCHEDULER_PR_TITLE,
    PR_BODY_PATH,
    SCHEDULER_PR_BODY_PATH,
    PR_NUMBER,
    SCHEDULER_PR_NUMBER,
    OBSERVABILITY_PR_NUMBER,
    OBSERVABILITY_BRANCH,
    SCHEDULER_COMMIT_MESSAGE,
    INTENDED_PR_FILES,
    SCHEDULER_MIGRATION_FILE,
    SCHEDULER_PR_FILES,
    SCHEDULER_PR_COMMITS,
    OBSERVABILITY_PR_FILES,
    OBSERVABILITY_DEPLOYED_AT,
    OBSERVABILITY_FIRST_AUTOMATIC_RUN_AT,
    OBSERVABILITY_TELEMETRY_MARKER,
    IMPORT_FUNCTION_NAME,
    IMPORT_FUNCTION_DIR,
    REQUIRED_IMPORT_SECRET,
    EXPECTED_SUPABASE_PROJECT_REF,
    SCHEDULER_VAULT_SECRET_NAME,
    CLI_COMMAND_NAME,
    CLI_BIN_RELATIVE,
    OPEN_SOURCE_GITHUB_REPO,
    OPEN_SOURCE_REPO_DESCRIPTION,
    FIRST_VERSION,
    FIRST_VERSION_TAG,
    FIRST_VERSION_RELEASE_NOTES,
    SECOND_VERSION,
    SECOND_VERSION_TAG,
    SECOND_VERSION_RELEASE_NOTES,
    DEFAULT_RUN_NEXT_DIR,
    CHECKPOINT_NAMES,
    ALLOWED_FLAGS,
    args,
    targetRepo,
    dryRun,
    selectedLane,
    activeCheckpointRun,
    evidence,
    actions,
    filesChanged,
    spawnSync,
    main,
    parseArgs,
    printHelp,
    printDoctor,
    printApprovalRegistry,
    printBoundaryExplanation,
    printLaneList,
    activeWorkItemFromLane,
    printRouteList,
    readControlFiles,
    readText,
    findActiveWorkItem,
    extractField,
    cleanField,
    routeStatus,
    permissionGranted,
    hasSchedulerVaultApplyPermission,
    canRunNow,
    nextApprovalCommand,
    modeLabel,
    needsJohn,
    stopAtBoundary,
    notImplemented,
    releaseVersionFromObjective,
  });

  const api = {};
  Object.assign(api, require("./lib/run-next/local-foundations"));
  Object.assign(api, require("./lib/run-next/release-routes"));
  Object.assign(api, require("./lib/run-next/github-routes"));
  Object.assign(api, require("./lib/run-next/supabase-control"));
  Object.assign(api, require("./lib/run-next/github-support"));
  Object.assign(api, require("./lib/run-next/supabase-auth"));
  Object.assign(api, require("./lib/run-next/runtime-routes"));
  Object.assign(api, require("./lib/run-next/scheduler-routes"));
  Object.assign(api, require("./lib/run-next/observability-routes"));
  Object.assign(api, require("./lib/run-next/supabase-planning"));
  Object.assign(api, require("./lib/run-next/runtime-core"));
  Object.assign(api, require("./lib/run-next/reports"));
  Object.assign(api, require("./lib/run-next/checkpoints"));
  runtimeContext.configure(api);
  loadedRuntimeApi = api;
  return loadedRuntimeApi;
}

const args = parseArgs(process.argv.slice(2));
let targetRepo = args.repo || DEFAULT_REPO;
const dryRun = args.dryRun || args.explain || args.explainNext;
let selectedLane = null;
let activeCheckpointRun = null;

const evidence = [];
const actions = [];
const filesChanged = [];

main();

function main() {
  try {
    if (args.status) {
      runtimeApi().printCheckpointStatus(targetRepo);
      return;
    }

    if (args.doctor) {
      printDoctor();
      return;
    }

    if (args.listApprovals) {
      printApprovalRegistry();
      return;
    }

    if (args.explainBoundary) {
      printBoundaryExplanation(args.explainBoundary);
      return;
    }

    if (args.resume) {
      const result = runtimeApi().runResume();
      runtimeApi().printResumeReport(result);
      process.exitCode = result.exitCode || 0;
      return;
    }

    if (args.listRoutes) {
      printRouteList();
      process.exit(0);
    }

    if (args.listLanes) {
      printLaneList();
      process.exit(0);
    }

    readControlFiles();
    let active;
    if (args.lane) {
      const state = laneState.readState(args.stateFile);
      selectedLane = laneState.getLane(state, args.lane);
      targetRepo = args.repo || selectedLane.repo_path || targetRepo;
      active = activeWorkItemFromLane(selectedLane);
    } else {
      const ledgerText = readText("work-ledger.md");
      active = findActiveWorkItem(ledgerText, targetRepo);
    }
    const status = active.currentStatus || "Unknown";
    const route = routeStatus(status, active);

    actions.push(`selected work item: ${active.heading || "latest ledger entry"}`);
    actions.push(`current status: ${status}`);
    actions.push(`next skill: ${route.skill}`);
    actions.push(`required authority/grant: ${route.required_authority || route.permission || "none"}`);

    if (!dryRun) {
      activeCheckpointRun = runtimeApi().createCheckpointRun({ active, route });
      runtimeApi().completeCheckpoint(activeCheckpointRun, "inspect", { branch: runtimeApi().gitBranch(targetRepo), head: runtimeApi().gitHead(targetRepo) });
      runtimeApi().completeCheckpoint(activeCheckpointRun, "route", { status, skill: route.skill, job: route.kind || route.nextAction || "unknown" });
      if (route.kind === "human-boundary" || route.kind === "permission-boundary") {
        runtimeApi().completeCheckpoint(activeCheckpointRun, "permission", { granted: false, reason: "human-boundary" });
      } else if (!permissionGranted(route)) {
        runtimeApi().completeCheckpoint(activeCheckpointRun, "permission", { granted: false, reason: "permission-required" });
      } else {
        runtimeApi().completeCheckpoint(activeCheckpointRun, "permission", { granted: true });
        runtimeApi().startCheckpoint(activeCheckpointRun, "execute");
      }
    }

    let result;
    if (route.kind === "human-boundary" || route.kind === "permission-boundary") {
      result = stopAtBoundary(route, active);
    } else if (!permissionGranted(route)) {
      result = needsJohn(route, active);
    } else if (route.kind === "github-handoff") {
      result = runtimeApi().runGithubHandoff(active);
    } else if (route.kind === "pr-readiness") {
      result = runtimeApi().runPrReadiness(active);
    } else if (route.kind === "pr-merge") {
      result = runtimeApi().runPrMerge(active);
    } else if (route.kind === "deployment-plan") {
      result = runtimeApi().runDeploymentPlan(active);
    } else if (route.kind === "supabase-preflight") {
      result = runtimeApi().runSupabasePreflight(active);
    } else if (route.kind === "supabase-tooling-auth") {
      result = runtimeApi().runSupabaseToolingAuth(active);
    } else if (route.kind === "supabase-link-secret-readiness") {
      result = runtimeApi().runSupabaseLinkSecretReadiness(active);
    } else if (route.kind === "scheduler-draft-pr") {
      result = runtimeApi().runSchedulerDraftPr(active);
    } else if (route.kind === "scheduler-pr-merge") {
      result = runtimeApi().runSchedulerPrMerge(active);
    } else if (route.kind === "supabase-secret-function-deploy") {
      result = runtimeApi().runSupabaseSecretFunctionDeploy(active);
    } else if (route.kind === "runtime-negative-verification") {
      result = runtimeApi().runRuntimeNegativeVerification(active);
    } else if (route.kind === "function-secret-deploy-negative-runtime") {
      result = runtimeApi().runFunctionSecretDeployNegativeRuntime(active);
    } else if (route.kind === "controlled-success-invocation") {
      result = runtimeApi().runControlledSuccessInvocation(active);
    } else if (route.kind === "scheduled-run-monitoring-handoff") {
      result = runtimeApi().runScheduledRunMonitoringHandoff(active);
    } else if (route.kind === "zero-output-pipeline-investigation") {
      result = runtimeApi().runZeroOutputPipelineInvestigation(active);
    } else if (route.kind === "zero-output-observability-patch") {
      result = runtimeApi().runZeroOutputObservabilityPatch(active);
    } else if (route.kind === "observability-pr-recovery") {
      result = runtimeApi().runObservabilityPrRecovery(active);
    } else if (route.kind === "zero-output-observability-deploy") {
      result = runtimeApi().runZeroOutputObservabilityDeploy(active);
    } else if (route.kind === "observability-run-recheck") {
      result = runtimeApi().runObservabilityRunRecheck(active);
    } else if (route.kind === "scheduler-application-decision") {
      result = runtimeApi().runSchedulerApplicationDecision(active);
    } else if (route.kind === "scheduler-vault-design-apply") {
      result = runtimeApi().runSchedulerVaultDesignApply(active);
    } else if (route.kind === "verification-bundle-self-test") {
      result = runtimeApi().runVerificationBundleSelfTest(active);
    } else if (route.kind === "local-skill-workpack") {
      result = runtimeApi().runLocalSkillWorkpack(active);
    } else if (route.kind === "cloudflare-opstruth-packaging-bundle") {
      result = runtimeApi().runCloudflareOpstruthPackagingBundle(active);
    } else if (route.kind === "clean-temp-readiness-smoke") {
      result = runtimeApi().runCleanTempReadinessSmoke(active);
    } else if (route.kind === "license-package-candidate") {
      result = runtimeApi().runLicensePackageCandidate(active);
    } else if (route.kind === "package-candidate-dry-run") {
      result = runtimeApi().runPackageCandidateDryRun(active);
    } else if (route.kind === "cli-entrypoint-package-smoke") {
      result = runtimeApi().runCliEntrypointPackageSmoke(active);
    } else if (route.kind === "github-open-source-handoff") {
      result = runtimeApi().runGithubOpenSourceHandoff(active);
    } else if (route.kind === "first-version-tag") {
      result = runtimeApi().runFirstVersionTag(active);
    } else if (route.kind === "semver-release-prep") {
      result = runtimeApi().runSemverReleasePrep(active);
    } else if (route.kind === "workflow-corpus-recovery") {
      result = runtimeApi().runWorkflowCorpusRecovery(active);
    } else if (route.kind === "docs-list-foundation") {
      result = runtimeApi().runDocsListFoundation(active);
    } else if (route.kind === "repo-map-helper-automation") {
      result = runtimeApi().runRepoMapHelperAutomation(active);
    } else if (route.kind === "project-kb-compiler") {
      result = runtimeApi().runProjectKbCompiler(active);
    } else if (route.kind === "pre-commit-validation-hook") {
      result = runtimeApi().runPreCommitValidationHook(active);
    } else if (route.kind === "migration-review-helper") {
      result = runtimeApi().runMigrationReviewHelper(active);
    } else {
      result = notImplemented(route, active);
    }

    if (activeCheckpointRun) runtimeApi().finalizeCheckpointRun(activeCheckpointRun, result);

    if (!dryRun && selectedLane) {
      runtimeApi().updateSelectedLane(result, route);
    } else if (!dryRun) {
      runtimeApi().appendLedger({
        status: result.ledgerStatus || result.finalStatus,
        result,
        active,
        route,
      });
      runtimeApi().appendRunLog({
        dryRun: false,
        status,
        result,
        active,
        route,
      });
    }

    runtimeApi().printReport(result, active, route);
    process.exit(result.exitCode || 0);
  } catch (error) {
    if (activeCheckpointRun) runtimeApi().stopCheckpointRun(activeCheckpointRun, error.message || "unhandled error");
    const result = {
      finalStatus: "BLOCKED",
      summary: error.message,
      exitCode: 1,
    };
    runtimeApi().printReport(result, {}, { skill: "coding-workflow-orchestrator-skill" });
    process.exit(1);
  }
}

function parseArgs(rawArgs) {
  const parsed = {
    allow: new Set(),
    dryRun: false,
    doctor: false,
    explain: false,
    explainNext: false,
    explainBoundary: null,
    resume: false,
    status: false,
    listApprovals: false,
    listRoutes: false,
    listLanes: false,
    untilBlocked: false,
    lane: null,
    stateFile: laneState.defaultStateFile(),
    repo: null,
  };

  for (let index = 0; index < rawArgs.length; index += 1) {
    const arg = rawArgs[index];
    if (arg === "--dry-run") {
      parsed.dryRun = true;
      continue;
    }
    if (arg === "--doctor") {
      parsed.doctor = true;
      continue;
    }
    if (arg === "--resume") {
      parsed.resume = true;
      continue;
    }
    if (arg === "--status") {
      parsed.status = true;
      continue;
    }
    if (arg === "--explain") {
      parsed.explain = true;
      continue;
    }
    if (arg === "--explain-next") {
      parsed.explainNext = true;
      continue;
    }
    if (arg === "--explain-boundary") {
      parsed.explainBoundary = rawArgs[index + 1];
      index += 1;
      if (!parsed.explainBoundary) runtimeApi().die("--explain-boundary requires a boundary type");
      continue;
    }
    if (arg === "--list-approvals") {
      parsed.listApprovals = true;
      continue;
    }
    if (arg === "--list-routes") {
      parsed.listRoutes = true;
      continue;
    }
    if (arg === "--list-lanes") {
      parsed.listLanes = true;
      continue;
    }
    if (arg === "--until-blocked") {
      parsed.untilBlocked = true;
      continue;
    }
    if (arg === "--lane") {
      parsed.lane = rawArgs[index + 1];
      index += 1;
      if (!parsed.lane) runtimeApi().die("--lane requires a lane id");
      continue;
    }
    if (arg === "--state-file") {
      parsed.stateFile = rawArgs[index + 1];
      index += 1;
      if (!parsed.stateFile) runtimeApi().die("--state-file requires a path");
      continue;
    }
    if (arg === "--repo") {
      parsed.repo = rawArgs[index + 1];
      index += 1;
      if (!parsed.repo) runtimeApi().die("--repo requires an absolute path");
      continue;
    }
    if (arg === "--allow") {
      const value = rawArgs[index + 1];
      index += 1;
      if (!value) runtimeApi().die("--allow requires a permission name");
      if (!ALLOWED_FLAGS.has(value)) {
        runtimeApi().die(`unsupported permission flag: ${value}`);
      }
      parsed.allow.add(value);
      continue;
    }
    if (arg === "--help" || arg === "-h") {
      printHelp();
      process.exit(0);
    }
    runtimeApi().die(`unknown argument: ${arg}`);
  }

  return parsed;
}

