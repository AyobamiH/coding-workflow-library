const SCHEDULER_PR_TITLE = "Draft import reddit tips scheduler secret migration";
const PR_BODY_PATH = path.join(DEFAULT_TEMP_ROOT, "import-reddit-tips-pr-body.md");
const SCHEDULER_PR_BODY_PATH = path.join(DEFAULT_TEMP_ROOT, "import-reddit-tips-scheduler-pr-body.md");
const PR_NUMBER = "11";
const SCHEDULER_PR_NUMBER = "12";
const OBSERVABILITY_PR_NUMBER = "13";
const OBSERVABILITY_BRANCH = "add-import-reddit-tips-observability";
const SCHEDULER_COMMIT_MESSAGE = "Draft import reddit tips scheduler secret migration";
const INTENDED_PR_FILES = [
  ".env.example",
  "docs/import-reddit-tips-security.md",
  "supabase/functions/import-reddit-tips/index.ts",
];
const SCHEDULER_MIGRATION_FILE = "supabase/migrations/20260613211912_update_import_reddit_tips_scheduler_secret.sql";
const SCHEDULER_PR_FILES = [
  "docs/import-reddit-tips-security.md",
  SCHEDULER_MIGRATION_FILE,
];
const SCHEDULER_PR_COMMITS = ["bba7253", "a43ee37"];
const OBSERVABILITY_PR_FILES = [
  "docs/import-reddit-tips-security.md",
  "supabase/functions/import-reddit-tips/index.ts",
  "supabase/functions/import-reddit-tips/pipelineTelemetry.test.ts",
  "supabase/functions/import-reddit-tips/pipelineTelemetry.ts",
];
const OBSERVABILITY_DEPLOYED_AT = "2026-06-26T04:31:58.976Z";
const OBSERVABILITY_FIRST_AUTOMATIC_RUN_AT = "2026-06-26T08:00:00.000Z";
const OBSERVABILITY_TELEMETRY_MARKER = "IMPORT_REDDIT_TIPS_PIPELINE_TELEMETRY";
const IMPORT_FUNCTION_NAME = "import-reddit-tips";
const IMPORT_FUNCTION_DIR = `supabase/functions/${IMPORT_FUNCTION_NAME}`;
const REQUIRED_IMPORT_SECRET = "IMPORT_REDDIT_TIPS_SECRET";
const EXPECTED_SUPABASE_PROJECT_REF = "viwxxjnehceedyctevau";
const SCHEDULER_VAULT_SECRET_NAME = "import_reddit_tips_scheduler_secret";
const CLI_COMMAND_NAME = "coding-workflow";
const CLI_BIN_RELATIVE = "bin/coding-workflow.js";
const OPEN_SOURCE_GITHUB_REPO = "AyobamiH/coding-workflow-library";
const OPEN_SOURCE_REPO_DESCRIPTION = "Autonomous coding workflow skills, routing, evidence, and permission-gated execution.";
const FIRST_VERSION = "0.1.0";
const FIRST_VERSION_TAG = `v${FIRST_VERSION}`;
const FIRST_VERSION_RELEASE_NOTES = `docs/releases/${FIRST_VERSION_TAG}.md`;
const SECOND_VERSION = "0.2.0";
const SECOND_VERSION_TAG = `v${SECOND_VERSION}`;
const SECOND_VERSION_RELEASE_NOTES = `docs/releases/${SECOND_VERSION_TAG}.md`;
const DEFAULT_RUN_NEXT_DIR = process.env.RUN_NEXT_DIR || path.join(LIBRARY_ROOT, ".run-next");
const CHECKPOINT_NAMES = ["inspect", "route", "permission", "execute", "verify", "record"];



let loadedRuntimeApi = null;

function runtimeApi() {
  if (loadedRuntimeApi) return loadedRuntimeApi;

  runtimeContext.configure({
    fs,
    os,
    path,
    laneState,
    objectiveAuthority,
    autonomousBoundaries,
    LIBRARY_ROOT,
    DEFAULT_REPO,
    DEFAULT_RUNTIME_ROOT,
    DEFAULT_ENV_FILE,
    DEFAULT_TEMP_ROOT,
    DEFAULT_NPM_CACHE,
    EXPECTED_GITHUB_REPO,
    EXPECTED_GITHUB_USER,
    FEATURE_BRANCH,
    SCHEDULER_BRANCH,
    EXPECTED_COMMIT,
    EXPECTED_COMMIT_SUBJECT,
    PR_TITLE,
    SCHEDULER_PR_TITLE,
    PR_BODY_PATH,
    SCHEDULER_PR_BODY_PATH,
    PR_NUMBER,
    SCHEDULER_PR_NUMBER,
    OBSERVABILITY_PR_NUMBER,
    OBSERVABILITY_BRANCH,
    SCHEDULER_COMMIT_MESSAGE,
    INTENDED_PR_FILES,
    SCHEDULER_MIGRATION_FILE,
    SCHEDULER_PR_FILES,
    SCHEDULER_PR_COMMITS,
    OBSERVABILITY_PR_FILES,
    OBSERVABILITY_DEPLOYED_AT,
    OBSERVABILITY_FIRST_AUTOMATIC_RUN_AT,
    OBSERVABILITY_TELEMETRY_MARKER,
    IMPORT_FUNCTION_NAME,
    IMPORT_FUNCTION_DIR,
    REQUIRED_IMPORT_SECRET,
    EXPECTED_SUPABASE_PROJECT_REF,
    SCHEDULER_VAULT_SECRET_NAME,
    CLI_COMMAND_NAME,
    CLI_BIN_RELATIVE,
    OPEN_SOURCE_GITHUB_REPO,
    OPEN_SOURCE_REPO_DESCRIPTION,
    FIRST_VERSION,
    FIRST_VERSION_TAG,
    FIRST_VERSION_RELEASE_NOTES,
    SECOND_VERSION,
    SECOND_VERSION_TAG,
    SECOND_VERSION_RELEASE_NOTES,
    DEFAULT_RUN_NEXT_DIR,
    CHECKPOINT_NAMES,
    ALLOWED_FLAGS,
    args,
    targetRepo,
    dryRun,
    selectedLane,
    activeCheckpointRun,
    evidence,
    actions,
    filesChanged,
    spawnSync,
    main,
    routeStatus,
  });

  const api = {};
  Object.assign(api, cliControl);
  Object.assign(api, require("./lib/run-next/route-access"));
  Object.assign(api, require("./lib/run-next/route-dispatch"));
  Object.assign(api, require("./lib/run-next/library-route-selection"));
  Object.assign(api, require("./lib/run-next/capability-intelligence-route"));
  Object.assign(api, require("./lib/run-next/capability-intelligence-product"));
  Object.assign(api, require("./lib/run-next/local-foundations"));
  Object.assign(api, require("./lib/run-next/release-routes"));
  Object.assign(api, require("./lib/run-next/github-routes"));
  Object.assign(api, require("./lib/run-next/supabase-control"));
  Object.assign(api, require("./lib/run-next/github-support"));
  Object.assign(api, require("./lib/run-next/supabase-auth"));
  Object.assign(api, require("./lib/run-next/runtime-routes"));
  Object.assign(api, require("./lib/run-next/scheduler-routes"));
  Object.assign(api, require("./lib/run-next/observability-routes"));
  Object.assign(api, require("./lib/run-next/supabase-planning"));
  Object.assign(api, require("./lib/run-next/runtime-core"));
  Object.assign(api, require("./lib/run-next/reports"));
  Object.assign(api, require("./lib/run-next/checkpoints"));
  runtimeContext.configure(api);
  loadedRuntimeApi = api;
  return loadedRuntimeApi;
}

const args = cliControl.parseArgs(process.argv.slice(2), ALLOWED_FLAGS);
let targetRepo = args.repo || DEFAULT_REPO;
const dryRun = args.dryRun || args.explain || args.explainNext;
let selectedLane = null;
let activeCheckpointRun = null;

const evidence = [];
const actions = [];
const filesChanged = [];

main();

function main() {
  try {
    if (args.help) {
      cliControl.printHelp(ALLOWED_FLAGS);
      return;
    }

    if (args.status) {
      runtimeApi().printCheckpointStatus(targetRepo);
      return;
    }

    if (args.doctor) {
      cliControl.printDoctor(LIBRARY_ROOT);
      return;
    }

    if (args.listApprovals) {
      cliControl.printApprovalRegistry(LIBRARY_ROOT);
      return;
    }

    if (args.explainBoundary) {
      cliControl.printBoundaryExplanation(args.explainBoundary);
      return;
    }

    if (args.resume) {
      const result = runtimeApi().runResume();
      runtimeApi().printResumeReport(result);
      process.exitCode = result.exitCode || 0;
      return;
    }

    if (args.listRoutes) {
      cliControl.printRouteList(LIBRARY_ROOT);
      process.exit(0);
    }

    if (args.listLanes) {
      cliControl.printLaneList(args.stateFile);
      process.exit(0);
    }

    cliControl.readControlFiles(LIBRARY_ROOT, evidence);
    let active;
    if (args.lane) {
      const state = laneState.readState(args.stateFile);
      selectedLane = laneState.getLane(state, args.lane);
      targetRepo = args.repo || selectedLane.repo_path || targetRepo;
      active = cliControl.activeWorkItemFromLane(selectedLane);
    } else {
      const ledgerText = cliControl.readText(LIBRARY_ROOT, "work-ledger.md");
      active = cliControl.findActiveWorkItem(ledgerText, targetRepo);
    }
    const status = active.currentStatus || "Unknown";
    const route = routeStatus(status, active);

    actions.push(`selected work item: ${active.heading || "latest ledger entry"}`);
    actions.push(`current status: ${status}`);
    actions.push(`next skill: ${route.skill}`);
    actions.push(`required authority/grant: ${route.required_authority || route.permission || "none"}`);

    if (!dryRun) {
      activeCheckpointRun = runtimeApi().createCheckpointRun({ active, route });
      runtimeApi().completeCheckpoint(activeCheckpointRun, "inspect", { branch: runtimeApi().gitBranch(targetRepo), head: runtimeApi().gitHead(targetRepo) });
      runtimeApi().completeCheckpoint(activeCheckpointRun, "route", { status, skill: route.skill, job: route.kind || route.nextAction || "unknown" });
      if (route.kind === "human-boundary" || route.kind === "permission-boundary") {
        runtimeApi().completeCheckpoint(activeCheckpointRun, "permission", { granted: false, reason: "human-boundary" });
      } else if (!runtimeApi().permissionGranted(route)) {
        runtimeApi().completeCheckpoint(activeCheckpointRun, "permission", { granted: false, reason: "permission-required" });
      } else {
        runtimeApi().completeCheckpoint(activeCheckpointRun, "permission", { granted: true });
        runtimeApi().startCheckpoint(activeCheckpointRun, "execute");
      }
    }

    const result = runtimeApi().dispatchRoute(route, active);

    if (activeCheckpointRun) runtimeApi().finalizeCheckpointRun(activeCheckpointRun, result);

    if (!dryRun && selectedLane) {
      runtimeApi().updateSelectedLane(result, route);
    } else if (!dryRun) {
      runtimeApi().appendLedger({
        status: result.ledgerStatus || result.finalStatus,
        result,
        active,
        route,
      });
      runtimeApi().appendRunLog({
        dryRun: false,
        status,
        result,
        active,
        route,
      });
    }

    runtimeApi().printReport(result, active, route);
    process.exit(result.exitCode || 0);
  } catch (error) {
    if (activeCheckpointRun) runtimeApi().stopCheckpointRun(activeCheckpointRun, error.message || "unhandled error");
    const result = {
      finalStatus: "BLOCKED",
      summary: error.message,
      exitCode: 1,
    };
    runtimeApi().printReport(result, {}, { skill: "coding-workflow-orchestrator-skill" });
    process.exit(1);
  }
}

function routeStatus(status, active = {}) {
  const normalized = status.toLowerCase();
  if (args.releaseManifest) {
    if (!dryRun) return { skill: "release-preflight-skill", permission: "release-publication", requiresAuthority: ["remote_publication"], kind: "permission-boundary", finalStatus: "BLOCKED_SAFETY", nextAction: "generic release manifest execution requires --dry-run until an installed authenticated adapter is configured" };
    return { skill: "release-preflight-skill / github-handoff-skill", permission: null, requiresAuthority: ["local_execution"], kind: "generic-npm-prerelease", nextAction: "validate the declarative exact-tarball npm prerelease without external calls" };
  }
  const activeObjective = active.rawLane?.objective ? objectiveAuthority.normalizeObjective(active.rawLane.objective) : null;

  const releaseVersion = runtimeApi().releaseVersionFromObjective(activeObjective?.id);
  if (releaseVersion && path.resolve(targetRepo) === LIBRARY_ROOT) {
    return {
      skill: "release-preflight-skill / skills-library-packaging-skill / github-handoff-skill",
      permission: "release-publication",
      requiresAuthority: ["remote_publication"],
      kind: "semver-release-prep",
      releaseVersion,
      nextAction: `prepare and verify v${releaseVersion}, then execute the authorized exact-commit publication sequence`,
    };
  }

  const libraryFoundationRoute = runtimeApi().selectLibraryFoundationRoute(status);
  if (libraryFoundationRoute) return libraryFoundationRoute;

  const capabilityIntelligenceRoute = runtimeApi().selectCapabilityIntelligenceRoute(status);
  if (capabilityIntelligenceRoute) return capabilityIntelligenceRoute;

  if (normalized === "no ledger item for repo") {
    return {
      skill: "repo-map-skill / coding-workflow-orchestrator-skill",
      permission: null,
      kind: "human-boundary",
      finalStatus: "NEEDS LEDGER ENTRY",
      nextPermission: "add a work-ledger.md item for this repo",
      nextAction: "add a work-ledger.md item for this repo before any mutating action",
    };
  }

  if (normalized === "ready to commit with caveats") {
    return {
      skill: "github-handoff-skill / scripts/committer",
      permission: "commit",
      kind: "not-implemented",
      nextAction: "run exact-file committer workflow",
    };
  }

  if (normalized === "committed locally, not pushed" || normalized === "needs github auth gate") {
    return {
      skill: "github-auth-gate-skill",
      permission: "auth-check",
      kind: "not-implemented",
      nextAction: "run GitHub auth gate",
    };
  }

  if (normalized === "needs john token replacement") {
    return {
      skill: "github-auth-gate-skill",
      permission: null,
      kind: "human-boundary",
      finalStatus: "NEEDS JOHN",
      nextAction: "replace or remove invalid local runtime token outside chat",
    };
  }

  if (normalized === "auth pass for github handoff") {
    return {
      skill: "github-handoff-skill",
      permission: "github-handoff",
      alternatePermission: "push-pr",
      kind: "github-handoff",
      nextAction: "create/switch feature branch, push feature branch only, and create or confirm PR",
    };
  }

  if (normalized === "pr opened, not merged") {
    return {
      skill: "github-handoff-skill / PR readiness inspection",
      permission: "pr-readiness",
      alternatePermission: "github-handoff",
      kind: "pr-readiness",
      nextAction: "inspect PR readiness and stop before merge",
    };
  }

  if (normalized === "pr ready for merge approval") {
    return {
      skill: "github-handoff-skill / PR merge handoff",
      permission: "pr-merge",
      kind: "pr-merge",
      nextAction: "merge PR #11 into main and stop before deployment planning",
    };
  }

  if (normalized === "merged, not deployed") {
    return {
      skill: "cloudflare-deploy-skill / supabase deployment planning",
      permission: "deployment-plan",
      kind: "deployment-plan",
      nextAction: "inspect source and produce deployment plan without deploying",
    };
  }

  if (normalized === "deployment plan ready, not deployed") {
    return {
      skill: "cloudflare-deploy-skill / supabase deployment execution planning",
      permission: "supabase-preflight",
      kind: "supabase-preflight",
      nextAction: "inspect Supabase execution prerequisites and draft exact execution sequence without executing it",
    };
  }

  if (normalized === "scheduler migration draft merged, supabase mutation still gated") {
    return {
      skill: "github-handoff-skill / scheduler PR #12 readiness and merge gate",
      permission: "scheduler-pr-merge",
      kind: "scheduler-pr-merge",
      nextAction: "verify already-merged scheduler PR #12 evidence and stop before any Supabase mutation",
    };
  }

  if (normalized === "supabase execution preflight ready, not executed") {
    return {
      skill: "cloudflare-deploy-skill / Supabase tooling/auth setup",
      permission: "supabase-tooling-auth",
      kind: "supabase-tooling-auth",
      nextAction: "verify Supabase CLI tooling and read-only project access without linking or mutating Supabase",
    };
  }

  if (
    normalized === "needs john: supabase access token missing" ||
    normalized === "needs john: supabase access token invalid" ||
    normalized === "needs john: supabase token lacks project access" ||
    normalized === "needs john: supabase project ref mismatch" ||
    normalized === "blocked: node/npx/supabase cli unavailable" ||
    normalized === "env file format issue"
  ) {
    return {
      skill: "cloudflare-deploy-skill / Supabase tooling/auth setup",
      permission: "supabase-tooling-auth",
      kind: "supabase-tooling-auth",
      nextAction: "retry Supabase tooling/auth verification after local credential or env correction",
    };
  }

  if (normalized === "supabase tooling/auth ready, not linked") {
    return {
      skill: "cloudflare-deploy-skill / Supabase link and secret readiness",
      permission: "supabase-link-secret-readiness",
      kind: "supabase-link-secret-readiness",
      nextAction: "link local repo to Supabase project and ensure local import secret readiness without remote secret setup or deploy",
    };
  }

  if (normalized === "supabase linked and local secret ready, not deployed") {
    return {
      skill: "cloudflare-deploy-skill / scheduler migration draft and GitHub handoff",
      permission: "scheduler-draft-pr",
      kind: "scheduler-draft-pr",
      nextAction: "draft guarded local scheduler migration, run local checks, exact-file commit, push feature branch, and open PR",
    };
  }

  if (
    normalized === "scheduler migration pr opened, not merged" ||
    normalized === "scheduler migration draft merged, supabase mutation still gated"
  ) {
    return {
      skill: "github-handoff-skill / scheduler PR #12 readiness and merge gate",
      permission: "scheduler-pr-merge",
      kind: "scheduler-pr-merge",
      nextAction: "inspect scheduler PR #12, merge only if still open and clean, then stop before any Supabase mutation",
    };
  }

  if (normalized === "scheduler migration draft merged, not applied" || normalized === "blocked: unexpected target repo changes") {
    return {
      skill: "supabase-function-deploy-skill / Supabase remote secret setup and single Edge Function deploy",
      permission: "supabase-secret-function-deploy",
      kind: "supabase-secret-function-deploy",
      nextAction: "verify source/auth/env, set remote import secret, deploy only import-reddit-tips, and stop before scheduler/runtime work",
    };
  }

  if (normalized === "function deployed and remote secret set, scheduler not applied") {
    return {
      skill: "runtime-verification-skill / deployed function negative runtime verification",
      permission: "runtime-negative-verification",
      kind: "runtime-negative-verification",
      nextAction: "run only OPTIONS, non-POST, unauthenticated POST, invalid scheduler secret, and anon-only rejection checks, then stop before any success path",
    };
  }

  if (normalized === "runtime negative checks passed, scheduler not applied") {
    return {
      skill: "supabase-scheduler-vault-skill / scheduler application decision",
      permission: "scheduler-application-decision",
      kind: "scheduler-application-decision",
      nextAction: "prove a safe scheduler secret-storage path, apply only import-reddit-tips-daily if proven, otherwise stop blocked",
    };
  }

  if (normalized === "runtime negative checks failed, scheduler blocked") {
    return {
      skill: "security-hardening-review-skill / runtime failure triage",
      permission: null,
      kind: "permission-boundary",
      finalStatus: "Runtime negative checks failed, scheduler blocked",
      nextPermission: "approve runtime failure triage and source patch plan",
      nextAction: "review failing negative runtime evidence before scheduler application",
    };
  }

  if (
    normalized === "function deployed, negative runtime verified, success path not run" ||
    normalized === "function deployed, dry-run runtime verified, success path not run"
  ) {
    return {
      skill: "runtime-verification-skill / controlled scheduler-path success invocation",
      permission: "controlled-success-invocation",
      kind: "controlled-success-invocation",
      nextAction: "collect read-only pet_tips metadata, run exactly one valid scheduler-secret POST, collect read-only after metadata, and stop",
    };
  }

  if (
    normalized === "controlled success invocation completed" ||
    normalized === "scheduled run pending, production handoff ready"
  ) {
    return {
      skill: "production-handoff-skill / scheduled-run monitoring and production handoff",
      permission: "scheduled-run-monitoring-handoff",
      kind: "scheduled-run-monitoring-handoff",
      nextAction: "inspect scheduler metadata, cron run history, pet_tips metadata, source/docs evidence, and prepare production handoff without invoking the function",
    };
  }

  if (normalized === "scheduled run observed, production handoff ready") {
    return {
      skill: "route-trace-skill / runtime-verification-skill / error-evidence-skill",
      permission: "zero-output-investigation",
      kind: "zero-output-pipeline-investigation",
      nextAction: "trace staged candidate attrition with source, safe database metadata, and available read-only logs without invoking production",
    };
  }

  if (normalized === "zero-output pipeline investigation blocked") {
    if (!args.allow.has("zero-output-investigation")) {
      return {
        skill: "runtime-verification-skill / route-trace-skill / error-evidence-skill",
        permission: "zero-output-observability-patch",
        kind: "zero-output-observability-patch",
        nextAction: "prepare a local count-only observability patch and stop before commit, PR, deploy, or runtime observation",
      };
    }

    return {
      skill: "route-trace-skill / runtime-verification-skill / error-evidence-skill",
      permission: "zero-output-investigation",
      kind: "zero-output-pipeline-investigation",
      nextAction: "retry the read-only staged pipeline investigation when the missing evidence source is available",
    };
  }

  if (normalized === "expected empty input proven, production handoff ready") {
    return {
      skill: "production-handoff-skill",
      permission: null,
      kind: "permission-boundary",
      finalStatus: "Expected empty input proven, production handoff ready",
      nextPermission: "complete production handoff or configure additional source inputs separately",
      nextAction: "choose production handoff completion or a separately approved source-configuration lane",
    };
  }

  if (normalized === "zero-output root cause proven, production handoff pending decision") {
    return {
      skill: "error-evidence-skill / coding-workflow-orchestrator-skill",
      permission: null,
      kind: "permission-boundary",
      finalStatus: "Zero-output root cause proven, production handoff pending decision",
      nextPermission: "approve configuration/data remediation plan",
      nextAction: "review the proven non-code cause before any remediation mutation",
    };
  }

  if (normalized === "zero-output local fix drafted, not committed or deployed") {
    return {
      skill: "github-handoff-skill / build-verify-skill",
      permission: null,
      kind: "permission-boundary",
      finalStatus: "Zero-output local fix drafted, not committed or deployed",
      nextPermission: "review and approve exact-file Wagging fix commit",
      nextAction: "review the local product diff and validation before any commit",
    };
  }

  if (normalized === "zero-output observability patch ready for review") {
    return {
      skill: "github-handoff-skill / build-verify-skill",
      permission: null,
      kind: "permission-boundary",
      finalStatus: "Zero-output observability patch ready for review",
      nextPermission: "exact-file Wagging commit, branch push, and PR creation",
      nextAction: "review the local patch and proceed through a separate GitHub handoff gate",
    };
  }

  if (normalized === "zero-output observability patch blocked") {
    return {
      skill: "error-evidence-skill / github-handoff-skill / runtime-verification-skill",
      permission: "observability-pr-recovery",
      kind: "observability-pr-recovery",
      nextAction: "classify external PR checks, rerun local quality, merge PR #13 only if the failed preview is advisory and unrelated",
    };
  }

  if (normalized === "zero-output observability patch merged, not deployed") {
    return {
      skill: "supabase-function-deploy-skill",
      permission: "observability-deploy",
      kind: "zero-output-observability-deploy",
      nextAction: "deploy only import-reddit-tips after confirming the merged telemetry patch is on main, then stop before manual runtime invocation",
    };
  }

  if (normalized === "zero-output observability deployed, awaiting automatic run" || normalized === "observability run pending") {
    return {
      skill: "runtime-verification-skill / production-handoff-skill",
      permission: "observability-run-recheck",
      kind: "observability-run-recheck",
      nextAction: "wait for a natural scheduled run and read safe telemetry without invoking production",
    };
  }

  if (
    normalized === "zero-output stage boundary proven" ||
    normalized === "observability run failed: investigate runtime" ||
    normalized === "observability evidence insufficient"
  ) {
    return {
      skill: "runtime-verification-skill / error-evidence-skill",
      permission: null,
      kind: "permission-boundary",
      finalStatus: status,
      nextPermission: "review observability result and choose remediation, wait, or handoff",
      nextAction: "do not change filters, sources, or data without a separate product decision",
    };
  }

  if (normalized === "scheduled run observed with failure: investigate scheduler/runtime") {
    return {
      skill: "error-evidence-skill / scheduled runtime failure investigation",
      permission: null,
      kind: "permission-boundary",
      finalStatus: "Scheduled run observed with failure: investigate scheduler/runtime",
      nextPermission: "run failure investigation with read-only evidence",
      nextAction: "inspect the failed scheduled run without invoking the function or mutating production",
    };
  }

  if (normalized === "scheduler applied, runtime success not verified") {
    return {
      skill: "runtime-verification-skill / controlled scheduler success verification",
      permission: null,
      kind: "permission-boundary",
      finalStatus: "Scheduler applied, runtime success not verified",
      nextPermission: "approve controlled scheduler success verification",
      nextAction: "await approval before any valid scheduler/admin success request or production success-path call",
    };
  }

  if (normalized === "scheduler blocked: safe secret storage path not proven") {
    return {
      skill: "supabase-scheduler-vault-skill / scheduler Vault design and apply gate",
      permission: "scheduler-vault-design-apply",
      kind: "scheduler-vault-design-apply",
      nextAction: "use DB URL to prove Vault, pg_cron, and pg_net capabilities, then store scheduler secret in Vault and replace only import-reddit-tips-daily if safe",
    };
  }

  if (
    normalized === "scheduler applied via vault, runtime success not verified" ||
    normalized === "scheduler applied via vault, runtime not verified"
  ) {
    return {
      skill: "supabase-function-deploy-skill / Edge Function secret, deploy, and negative runtime gate",
      permission: "function-secret-deploy-negative-runtime",
      kind: "function-secret-deploy-negative-runtime",
      finalStatus: "Scheduler applied via Vault, runtime not verified",
      nextPermission: "function-secret-deploy-negative-runtime",
      nextAction: "set remote import secret, deploy only import-reddit-tips, run non-mutating runtime checks, and stop before any success import/write path",
    };
  }

  if (normalized === "needs john: database connection url missing") {
    return {
      skill: "env-audit-skill / Supabase database URL provisioning",
      permission: null,
      kind: "permission-boundary",
      finalStatus: "Needs John: database connection URL missing",
      nextPermission: "add SUPABASE_DB_URL locally",
      nextAction: "add SUPABASE_DB_URL or DATABASE_URL to <RUNTIME_ENV_FILE> without pasting it into chat",
    };
  }

  if (normalized === "needs john: psql unavailable for non-interactive db inspection") {
    return {
      skill: "env-audit-skill / local SQL tooling provisioning",
      permission: null,
      kind: "permission-boundary",
      finalStatus: "Needs John: psql unavailable for non-interactive DB inspection",
      nextPermission: "install psql locally or provide an approved non-interactive SQL tool",
      nextAction: "install psql or provide another approved non-interactive DB inspection method",
    };
  }

  if (
    normalized === "needs john: sudo password required to install psql" ||
    (normalized === "needs john" && runtimeApi().hasSchedulerVaultApplyPermission())
  ) {
    return {
      skill: "security-hardening-review-skill / scheduler Vault design and apply gate",
      permission: args.allow.has("scheduler-vault-apply-retry") ? "scheduler-vault-apply-retry" : "scheduler-vault-design-apply",
      kind: "scheduler-vault-design-apply",
      nextAction: "resume scheduler Vault design/apply now that psql is available",
    };
  }

  if (normalized === "scheduler blocked: vault/pg_cron/pg_net capability not proven") {
    if (runtimeApi().hasSchedulerVaultApplyPermission()) {
      return {
        skill: "security-hardening-review-skill / scheduler Vault design and apply gate",
        permission: args.allow.has("scheduler-vault-apply-retry") ? "scheduler-vault-apply-retry" : "scheduler-vault-design-apply",
        kind: "scheduler-vault-design-apply",
        nextAction: "retry scheduler Vault design/apply after capability tooling changes",
      };
    }
    return {
      skill: "security-hardening-review-skill / scheduler secret storage design",
      permission: null,
      kind: "permission-boundary",
      finalStatus: "Scheduler blocked: Vault/pg_cron/pg_net capability not proven",
      nextPermission: "approve manual Vault/dashboard scheduler path",
      nextAction: "prove or provision Vault, pg_cron, pg_net, and database inspection outside this runner",
    };
  }

  if (normalized === "db connectivity blocked") {
    if (runtimeApi().hasSchedulerVaultApplyPermission()) {
      return {
        skill: "security-hardening-review-skill / scheduler Vault design and apply gate",
        permission: args.allow.has("scheduler-vault-apply-retry") ? "scheduler-vault-apply-retry" : "scheduler-vault-design-apply",
        kind: "scheduler-vault-design-apply",
        nextAction: "retry scheduler Vault design/apply after DB connectivity changes",
      };
    }
    return {
      skill: "security-hardening-review-skill / scheduler DB connectivity repair",
      permission: null,
      kind: "permission-boundary",
      finalStatus: "DB CONNECTIVITY BLOCKED",
      nextPermission: "provide an IPv4-reachable Supabase pooler DB URL",
      nextAction: "fix or replace SUPABASE_DB_URL without printing it, then retry scheduler Vault apply",
    };
  }

  if (normalized === "db url still points to direct host") {
    if (runtimeApi().hasSchedulerVaultApplyPermission()) {
      return {
        skill: "security-hardening-review-skill / scheduler Vault design and apply gate",
        permission: args.allow.has("scheduler-vault-apply-retry") ? "scheduler-vault-apply-retry" : "scheduler-vault-design-apply",
        kind: "scheduler-vault-design-apply",
        nextAction: "retry scheduler Vault design/apply after replacing SUPABASE_DB_URL with a pooler URL",
      };
    }
    return {
      skill: "security-hardening-review-skill / scheduler DB URL repair",
      permission: null,
      kind: "permission-boundary",
      finalStatus: "DB URL STILL POINTS TO DIRECT HOST",
      nextPermission: "provide an IPv4-reachable Supabase pooler DB URL",
      nextAction: "replace SUPABASE_DB_URL with a pooler URL without printing it, then retry scheduler Vault apply",
    };
  }

  if (normalized === "local verification and release evidence bundle built") {
    return {
      skill: "release-preflight-skill / verification bundle autonomous self-test",
      permission: "verification-bundle-self-test",
      kind: "verification-bundle-self-test",
      nextAction: "run npm package readiness, release preflight, evidence-pack dry-run, and validation against the selected repo without publish/tag/push/deploy/external mutation",
    };
  }

  if (normalized === "verification bundle self-test complete") {
    return {
      skill: "coding-workflow-orchestrator-skill / local reusable skill workpack",
      permission: "local-skill-workpack",
      kind: "local-skill-workpack",
      nextAction: "harden local verification classification, write exactly one evidence pack, harden failure evidence, extract runtime verification, harden GitHub lifecycle docs, validate, and stop",
    };
  }

  if (normalized === "local skill workpack complete") {
    return {
      skill: "coding-workflow-orchestrator-skill",
      permission: null,
      kind: "human-boundary",
      finalStatus: "Local skill workpack complete",
      nextPermission: "route next immediate skill bundle",
      nextAction: "select the next immediate skill bundle from build-queue.md",
    };
  }

  if (normalized === "embedded production lanes extracted into reusable routes") {
    return {
      skill: "coding-workflow-orchestrator-skill / Cloudflare Opstruth packaging bundle",
      permission: "cloudflare-opstruth-packaging-bundle",
      kind: "cloudflare-opstruth-packaging-bundle",
      nextAction: "run local route audit, packaging readiness, release preflight local mode, and validation, then stop before deploy, publish, push, tag, secret, or production work",
    };
  }

  if (normalized === "cloudflare opstruth packaging routes extracted") {
    return {
      skill: "skills-library-packaging-skill / clean-temp readiness smoke",
      permission: "clean-temp-readiness-smoke",
      kind: "clean-temp-readiness-smoke",
      nextAction: "create a clean local temp copy, run route/readiness/preflight/validation checks from that copy, remove the temp copy, and stop before release or product work",
    };
  }

  if (normalized === "clean-temp readiness smoke complete") {
    return {
      skill: "skills-library-packaging-skill / MIT licence and package candidate scaffold",
      permission: "license-package-candidate",
      kind: "license-package-candidate",
      nextAction: "verify the approved MIT license file, package candidate scaffold, route metadata, and local package readiness without publishing, tagging, pushing, or releasing",
    };
  }

  if (normalized === "mit licence and package candidate scaffold complete") {
    return {
      skill: "skills-library-packaging-skill / npm-package-readiness-skill / release-preflight-skill",
      permission: "package-candidate-dry-run",
      kind: "package-candidate-dry-run",
      nextAction: "verify package identity, run npm package readiness, run npm pack dry-run, inspect package contents, run clean-temp package smoke, validate, and stop before publish/version/tag/push/release",
    };
  }

  if (
    normalized === "package candidate dry-run complete" ||
    normalized === "cli entrypoint package smoke blocked"
  ) {
    return {
      skill: "skills-library-packaging-skill / npm-package-readiness-skill / release-preflight-skill",
      permission: "cli-package-smoke",
      kind: "cli-entrypoint-package-smoke",
      nextAction: "verify the local coding-workflow CLI entrypoint, run CLI package readiness, perform clean-temp tarball install smoke, validate, and stop before publish/version/tag/push/release",
    };
  }

  if (
    normalized === "cli entrypoint package smoke complete" ||
    normalized === "github open-source handoff blocked"
  ) {
    return {
      skill: "github-handoff-skill / skills-library-packaging-skill / release-preflight-skill",
      permission: "github-open-source-handoff",
      kind: "github-open-source-handoff",
      nextAction: "harden public repository files, run local validation, verify GitHub auth/repo safety, create or verify public repo, exact-file commit, push main, verify remote HEAD, and stop before publish/version/tag/release/deploy",
    };
  }

  if (
    normalized === "github open-source handoff complete" ||
    normalized === "first version tag blocked" ||
    normalized === "v0.1.0 release commit prepared, tag not created" ||
    normalized === "v0.1.0 tagged and pushed, npm unpublished"
  ) {
    return {
      skill: "release-preflight-skill / github-handoff-skill / skills-library-packaging-skill",
      permission: "first-version-tag",
      kind: "first-version-tag",
      nextAction: "prepare version 0.1.0, validate, exact-file commit, push main, verify CI, create and push annotated tag v0.1.0, verify remote tag, record bookkeeping, and stop before npm publish or GitHub release",
    };
  }

  if (
    normalized === "pr blocked by checks" ||
    normalized === "pr blocked by unexpected files" ||
    normalized === "pr blocked by mergeability" ||
    normalized === "pr readiness unknown"
  ) {
    return {
      skill: "github-handoff-skill",
      permission: null,
      kind: "permission-boundary",
      finalStatus: status,
      nextAction: "John may approve fixing PR blockers, approve fixing lint/Vitest blockers, or hold",
    };
  }

  return {
    skill: "coding-workflow-orchestrator-skill",
    permission: null,
    kind: "human-boundary",
    finalStatus: "NEEDS JOHN",
    nextAction: `unknown ledger status: ${status}`,
  };
}
