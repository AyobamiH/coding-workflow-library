#!/usr/bin/env node

const fs = require("fs");
const os = require("os");
const path = require("path");
const { spawnSync } = require("child_process");

const OPERATIONS = new Set(["status", "validate-file", "run"]);
const STATUSES = new Set(["PASS", "FAIL", "BLOCKED_CAPABILITY", "BLOCKED_PERMISSION"]);
const INPUT_TYPES = new Set(["dotenv", "ini", "json", "yaml"]);
const BOUNDARIES = [
  "SOPS and age capability checks never enumerate secret names or decrypted values",
  "encrypted-file validation uses sops filestatus and never decrypts the selected file",
  "runtime decryption is restricted to age and one explicitly selected SOPS file",
  "decrypted values are injected only into one child process and are never relayed by this helper",
  "secret access requires explicit --allow-secret-access and grants no child consequence authority",
  "the helper never runs sops decrypt, edit, set, unset, publish, rotate, updatekeys, or exec-file",
];

function usage() {
  console.log(`Usage:
  ./scripts/sops-age-secret-access status [--json] [--validate]
  ./scripts/sops-age-secret-access validate-file --file <encrypted-file> [--input-type TYPE] [--json] [--validate]
  ./scripts/sops-age-secret-access run --file <encrypted-file> [--key-file <age-identity>] --dry-run [--json] [--validate] -- <command> [args...]
  ./scripts/sops-age-secret-access run --file <encrypted-file> [--key-file <age-identity>] --allow-secret-access [--json] [--validate] -- <command> [args...]

The helper provides a narrow, non-printing SOPS + age adapter. It validates
tooling and encrypted-file status without decryption, then delegates one approved
runtime injection to "sops exec-env --pristine". Provider and child stdout/stderr
are captured and suppressed.

Options:
  --file PATH              Existing SOPS-encrypted dotenv, INI, JSON, or YAML file.
  --input-type TYPE        Override file type: dotenv, ini, json, or yaml.
  --key-file PATH          Explicit age identity file; never emitted in reports.
  --sops-bin PATH          Override the SOPS executable.
  --age-bin PATH           Override the age executable.
  --age-keygen-bin PATH    Override the age-keygen executable.
  --timeout-ms NUMBER      Provider/child timeout. Default: 30000.
  --allow-secret-access    Permit one output-suppressed exec-env attempt.
  --dry-run                Validate and plan without decryption or child execution.
  --json                   Print machine-readable output.
  --validate               Validate the generated report contract.
  --help                   Show this help.

This command never grants publish, deploy, production mutation, secret mutation,
or destructive authority to the delegated child process.`);
}

function requireValue(argv, index, flag) {
  const value = argv[index];
  if (!value) throw new Error(`${flag} requires a value`);
  return value;
}

function parsePositiveInteger(value, flag, minimum, maximum) {
  if (!/^\d+$/.test(String(value || ""))) throw new Error(`${flag} requires an integer`);
  const parsed = Number(value);
  if (parsed < minimum || parsed > maximum) {
    throw new Error(`${flag} must be between ${minimum} and ${maximum}`);
  }
  return parsed;
}

function parseArgs(argv) {
  const separator = argv.indexOf("--");
  const optionArgs = separator === -1 ? argv : argv.slice(0, separator);
  const childCommand = separator === -1 ? [] : argv.slice(separator + 1);
  const args = {
    operation: null,
    file: null,
    inputType: null,
    keyFile: null,
    sopsBin: "sops",
    ageBin: "age",
    ageKeygenBin: "age-keygen",
    timeoutMs: 30000,
    allowSecretAccess: false,
    dryRun: false,
    json: false,
    validate: false,
    help: false,
    childCommand,
  };

  for (let index = 0; index < optionArgs.length; index += 1) {
    const arg = optionArgs[index];
    if (!args.operation && OPERATIONS.has(arg)) args.operation = arg;
    else if (arg === "--file") args.file = requireValue(optionArgs, ++index, arg);
    else if (arg === "--input-type") {
      args.inputType = requireValue(optionArgs, ++index, arg);
      if (!INPUT_TYPES.has(args.inputType)) throw new Error("--input-type is invalid");
    } else if (arg === "--key-file") args.keyFile = requireValue(optionArgs, ++index, arg);
    else if (arg === "--sops-bin") args.sopsBin = requireValue(optionArgs, ++index, arg);
    else if (arg === "--age-bin") args.ageBin = requireValue(optionArgs, ++index, arg);
    else if (arg === "--age-keygen-bin") args.ageKeygenBin = requireValue(optionArgs, ++index, arg);
    else if (arg === "--timeout-ms") {
      args.timeoutMs = parsePositiveInteger(requireValue(optionArgs, ++index, arg), arg, 1000, 120000);
    } else if (arg === "--allow-secret-access") args.allowSecretAccess = true;
    else if (arg === "--dry-run") args.dryRun = true;
    else if (arg === "--json") args.json = true;
    else if (arg === "--validate") args.validate = true;
    else if (arg === "--help" || arg === "-h") args.help = true;
    else throw new Error(`unknown argument: ${arg}`);
  }

  if (!args.operation && !args.help) throw new Error("operation is required");
  if (["validate-file", "run"].includes(args.operation) && !args.file) {
    throw new Error(`${args.operation} requires --file`);
  }
  if (args.operation === "run" && !args.childCommand.length) {
    throw new Error("run requires -- <command> [args...]");
  }
  if (args.operation !== "run" && args.childCommand.length) {
    throw new Error(`operation ${args.operation} does not accept a child command`);
  }
  return args;
}

function safeFinding(code, severity) {
  return { code, severity };
}

function invoke(binary, args, options = {}) {
  const isNodeFile = /\.(?:c|m)?js$/i.test(binary);
  const command = isNodeFile ? process.execPath : binary;
  const commandArgs = isNodeFile ? [binary, ...args] : args;
  return spawnSync(command, commandArgs, {
    cwd: options.cwd || process.cwd(),
    env: options.env || process.env,
    encoding: "utf8",
    input: "",
    timeout: options.timeoutMs || 30000,
    maxBuffer: 1024 * 1024,
    windowsHide: true,
  });
}

function completedSuccessfully(result) {
  return Boolean(result) && typeof result.status === "number" && result.status === 0;
}

function inspectTool(binary, versionArgs, pattern, timeoutMs) {
  const result = invoke(binary, versionArgs, { timeoutMs });
  if (completedSuccessfully(result)) {
    const output = `${result.stdout || ""}${result.stderr || ""}`;
    const match = output.match(pattern);
    return { state: "AVAILABLE", version: match ? match[1] : null, reason: null };
  }
  if (result.error && result.error.code === "ENOENT") {
    return { state: "MISSING", version: null, reason: "TOOL_NOT_FOUND" };
  }
  if (result.error && result.error.code === "ETIMEDOUT") {
    return { state: "UNAVAILABLE", version: null, reason: "TOOL_VERSION_TIMEOUT" };
  }
  if (result.error || result.status !== 0) {
    return { state: "UNAVAILABLE", version: null, reason: "TOOL_VERSION_FAILED" };
  }
  return { state: "UNAVAILABLE", version: null, reason: "TOOL_VERSION_FAILED" };
}

function defaultIdentityFile(env = process.env) {
  const home = env.HOME || env.USERPROFILE || os.homedir();
  const configRoot = env.XDG_CONFIG_HOME || path.join(home, ".config");
  return path.join(configRoot, "sops", "age", "keys.txt");
}

function inspectIdentity(args, env = process.env) {
  const candidates = [];
  if (args.keyFile) candidates.push({ source: "explicit_file", file: args.keyFile });
  if (env.SOPS_AGE_KEY_FILE) candidates.push({ source: "environment_file", file: env.SOPS_AGE_KEY_FILE });
  if (env.SOPS_AGE_KEY) candidates.push({ source: "inline_environment", file: null });
  candidates.push({ source: "default_file", file: defaultIdentityFile(env) });

  for (const candidate of candidates) {
    if (candidate.source === "inline_environment") {
      return {
        state: "AVAILABLE",
        source: candidate.source,
        private_permissions: null,
        reason: null,
      };
    }
    try {
      const stat = fs.statSync(candidate.file);
      if (!stat.isFile()) continue;
      const privatePermissions = process.platform === "win32" ? null : (stat.mode & 0o077) === 0;
      return {
        state: privatePermissions === false ? "UNSAFE" : "AVAILABLE",
        source: candidate.source,
        private_permissions: privatePermissions,
        reason: privatePermissions === false ? "IDENTITY_PERMISSIONS_TOO_OPEN" : null,
      };
    } catch {
      // Try the next configured identity source.
    }
  }

  return {
    state: "NOT_CONFIGURED",
    source: "none",
    private_permissions: null,
    reason: "AGE_IDENTITY_NOT_CONFIGURED",
  };
}

function inferInputType(file) {
  const lower = path.basename(file).toLowerCase();
  if (lower.endsWith(".env")) return "dotenv";
  if (lower.endsWith(".ini")) return "ini";
  if (lower.endsWith(".json")) return "json";
  if (lower.endsWith(".yaml") || lower.endsWith(".yml")) return "yaml";
  return null;
}

function inspectEncryptedFile(args) {
  const report = {
    file_name: path.basename(args.file),
    input_type: args.inputType || inferInputType(args.file),
    size_bytes: 0,
    encrypted: false,
    valid: false,
    findings: [],
  };

  let stat;
  try {
    stat = fs.statSync(args.file);
  } catch {
    report.findings.push(safeFinding("ENCRYPTED_FILE_NOT_FOUND", "error"));
    return report;
  }
  if (!stat.isFile()) {
    report.findings.push(safeFinding("ENCRYPTED_FILE_NOT_REGULAR", "error"));
    return report;
  }
  report.size_bytes = stat.size;
  if (stat.size > 10 * 1024 * 1024) {
    report.findings.push(safeFinding("ENCRYPTED_FILE_TOO_LARGE", "error"));
    return report;
  }
  if (!report.input_type || !INPUT_TYPES.has(report.input_type)) {
    report.findings.push(safeFinding("ENCRYPTED_FILE_TYPE_UNKNOWN", "error"));
    return report;
  }

  const result = invoke(
    args.sopsBin,
    ["filestatus", "--input-type", report.input_type, args.file],
    { timeoutMs: args.timeoutMs },
  );
  if (completedSuccessfully(result)) {
    try {
      const status = JSON.parse(result.stdout || "{}");
      report.encrypted = status.encrypted === true;
    } catch {
      report.findings.push(safeFinding("FILE_STATUS_OUTPUT_INVALID", "error"));
      return report;
    }
    if (!report.encrypted) {
      report.findings.push(safeFinding("PLAINTEXT_FILE_REFUSED", "error"));
      return report;
    }
    report.valid = true;
    return report;
  }
  if (result.error && result.error.code === "ETIMEDOUT") {
    report.findings.push(safeFinding("FILE_STATUS_TIMEOUT", "error"));
    return report;
  }
  if (result.error || result.status !== 0) {
    report.findings.push(safeFinding("FILE_STATUS_FAILED", "error"));
    return report;
  }
  return report;
}

function baseReport(operation) {
  return {
    schema_version: 1,
    provider: "sops-age",
    operation,
    status: "PASS",
    capability: {
      sops: { state: "NOT_CHECKED", version: null },
      age: { state: "NOT_CHECKED", version: null },
      age_keygen: { state: "NOT_CHECKED", version: null },
      identity: {
        state: "NOT_CHECKED",
        source: "none",
        private_permissions: null,
      },
    },
    encrypted_file: null,
    execution: null,
    guarantees: {
      decrypted_values_emitted: false,
      provider_output_emitted: false,
      private_identity_emitted: false,
      plaintext_files_written: false,
      repository_files_written: false,
    },
    findings: [],
    boundaries: [...BOUNDARIES],
    next_action: "",
  };
}

function inspectCapabilities(args, env = process.env) {
  return {
    sops: inspectTool(args.sopsBin, ["--version", "--disable-version-check"], /\b(\d+\.\d+\.\d+)\b/, args.timeoutMs),
    age: inspectTool(args.ageBin, ["--version"], /\bv?(\d+\.\d+\.\d+)\b/, args.timeoutMs),
    ageKeygen: inspectTool(args.ageKeygenBin, ["--version"], /\bv?(\d+\.\d+\.\d+)\b/, args.timeoutMs),
    identity: inspectIdentity(args, env),
  };
}

function applyCapabilities(report, capabilities) {
  report.capability.sops = {
    state: capabilities.sops.state,
    version: capabilities.sops.version,
  };
  report.capability.age = {
    state: capabilities.age.state,
    version: capabilities.age.version,
  };
  report.capability.age_keygen = {
    state: capabilities.ageKeygen.state,
    version: capabilities.ageKeygen.version,
  };
  report.capability.identity = {
    state: capabilities.identity.state,
    source: capabilities.identity.source,
    private_permissions: capabilities.identity.private_permissions,
  };
}

function capabilityFindings(capabilities, requireIdentity) {
  const findings = [];
  if (capabilities.sops.state !== "AVAILABLE") findings.push(safeFinding("SOPS_NOT_AVAILABLE", "blocker"));
  if (capabilities.age.state !== "AVAILABLE") findings.push(safeFinding("AGE_NOT_AVAILABLE", "blocker"));
  if (capabilities.ageKeygen.state !== "AVAILABLE") findings.push(safeFinding("AGE_KEYGEN_NOT_AVAILABLE", "blocker"));
  if (requireIdentity && capabilities.identity.state === "NOT_CONFIGURED") {
    findings.push(safeFinding("AGE_IDENTITY_NOT_CONFIGURED", "blocker"));
  }
  if (capabilities.identity.state === "UNSAFE") {
    findings.push(safeFinding("IDENTITY_PERMISSIONS_TOO_OPEN", "blocker"));
  }
  if (capabilities.identity.source === "inline_environment") {
    findings.push(safeFinding("INLINE_IDENTITY_ENVIRONMENT_DISCOURAGED", "warning"));
  }
  return findings;
}

function buildStatusReport(args, env = process.env) {
  const report = baseReport("status");
  const capabilities = inspectCapabilities(args, env);
  applyCapabilities(report, capabilities);
  report.findings.push(...capabilityFindings(capabilities, true));
  if (report.findings.some((finding) => finding.severity === "blocker")) {
    report.status = "BLOCKED_CAPABILITY";
    report.next_action = "Install SOPS and age or configure one private age identity file, then rerun status.";
    return report;
  }
  report.next_action = "Select one SOPS-encrypted file and validate it before any approved runtime injection.";
  return report;
}

function buildFileReport(args) {
  const report = baseReport("validate-file");
  const sops = inspectTool(args.sopsBin, ["--version", "--disable-version-check"], /\b(\d+\.\d+\.\d+)\b/, args.timeoutMs);
  report.capability.sops = { state: sops.state, version: sops.version };
  if (sops.state !== "AVAILABLE") {
    report.status = "BLOCKED_CAPABILITY";
    report.findings.push(safeFinding("SOPS_NOT_AVAILABLE", "blocker"));
    report.next_action = "Install SOPS before encrypted-file validation.";
    return report;
  }
  report.encrypted_file = inspectEncryptedFile(args);
  report.findings.push(...report.encrypted_file.findings);
  if (!report.encrypted_file.valid) report.status = "FAIL";
  report.next_action = report.encrypted_file.valid
    ? "Encrypted-file validation passed; use run --dry-run before secret access."
    : "Select a valid SOPS-encrypted dotenv, INI, JSON, or YAML file.";
  return report;
}

function quoteForShell(value) {
  if (process.platform === "win32") {
    return `"${String(value).replace(/(["^&|<>%!])/g, "^$1")}"`;
  }
  return `'${String(value).replace(/'/g, "'\\''")}'`;
}

function childLauncherCommand(childCommand) {
  const payload = Buffer.from(JSON.stringify(childCommand), "utf8").toString("base64url");
  return [
    quoteForShell(process.execPath),
    quoteForShell(__filename),
    "__exec-child",
    payload,
  ].join(" ");
}

function buildRunEnvironment(args, env) {
  const next = { ...env };
  if (args.keyFile) next.SOPS_AGE_KEY_FILE = args.keyFile;
  next.SOPS_DECRYPTION_ORDER = "age";
  next.SOPS_DISABLE_VERSION_CHECK = "1";
  return next;
}

function buildRunReport(args, env = process.env) {
  const report = baseReport("run");
  report.execution = {
    attempted: false,
    dry_run: args.dryRun,
    command_name: path.basename(args.childCommand[0]),
    exit_code: null,
    signal: null,
    stdout_bytes_suppressed: 0,
    stderr_bytes_suppressed: 0,
  };

  const capabilities = inspectCapabilities(args, buildRunEnvironment(args, env));
  applyCapabilities(report, capabilities);
  report.findings.push(...capabilityFindings(capabilities, true));
  if (report.findings.some((finding) => finding.severity === "blocker")) {
    report.status = "BLOCKED_CAPABILITY";
    report.next_action = "Resolve the SOPS, age, or private identity blocker before runtime injection.";
    return report;
  }

  report.encrypted_file = inspectEncryptedFile(args);
  report.findings.push(...report.encrypted_file.findings);
  if (!report.encrypted_file.valid) {
    report.status = "FAIL";
    report.next_action = "Use a valid SOPS-encrypted file before runtime injection.";
    return report;
  }

  if (args.dryRun) {
    report.next_action = "Dry-run passed; use --allow-secret-access only for this exact file and child command.";
    return report;
  }
  if (!args.allowSecretAccess) {
    report.status = "BLOCKED_PERMISSION";
    report.findings.push(safeFinding("SECRET_ACCESS_NOT_GRANTED", "blocker"));
    report.next_action = "Rerun with --allow-secret-access only under an objective authorising this exact injection.";
    return report;
  }

  const result = invoke(
    args.sopsBin,
    [
      "exec-env",
      "--pristine",
      "--decryption-order",
      "age",
      args.file,
      childLauncherCommand(args.childCommand),
    ],
    {
      timeoutMs: args.timeoutMs,
      env: buildRunEnvironment(args, env),
    },
  );
  report.execution.attempted = true;
  report.execution.exit_code = typeof result.status === "number" ? result.status : null;
  report.execution.signal = result.signal || null;
  report.execution.stdout_bytes_suppressed = Buffer.byteLength(result.stdout || "");
  report.execution.stderr_bytes_suppressed = Buffer.byteLength(result.stderr || "");

  if (completedSuccessfully(result)) {
    report.next_action = "Record only the exit status and suppressed byte counts; do not expose decrypted values.";
    return report;
  }
  if (result.error && result.error.code === "ETIMEDOUT") {
    report.status = "FAIL";
    report.findings.push(safeFinding("SOPS_EXEC_ENV_TIMEOUT", "error"));
    report.next_action = "Inspect the child timeout without printing SOPS or child output.";
    return report;
  }
  if (result.error || result.status !== 0) {
    report.status = "FAIL";
    report.findings.push(safeFinding("SOPS_OR_CHILD_COMMAND_FAILED", "error"));
    report.next_action = "Inspect identity availability and the child contract; raw output remains suppressed.";
    return report;
  }

  return report;
}

function findForbiddenReportKey(value, trail = []) {
  if (Array.isArray(value)) {
    for (let index = 0; index < value.length; index += 1) {
      const found = findForbiddenReportKey(value[index], trail.concat(index));
      if (found) return found;
    }
    return null;
  }
  if (!value || typeof value !== "object") return null;
  for (const [key, item] of Object.entries(value)) {
    if (["stdout", "stderr", "raw_output", "decrypted_value", "identity_value", "recipient"].includes(key)) {
      return trail.concat(key).join(".");
    }
    const found = findForbiddenReportKey(item, trail.concat(key));
    if (found) return found;
  }
  return null;
}

function validateReport(report) {
  const errors = [];
  if (!report || report.schema_version !== 1) errors.push("schema_version must be 1");
  if (report.provider !== "sops-age") errors.push("provider must be sops-age");
  if (!OPERATIONS.has(report.operation)) errors.push("operation is invalid");
  if (!STATUSES.has(report.status)) errors.push("status is invalid");
  if (!report.capability || !report.capability.sops || !report.capability.identity) {
    errors.push("capability shape is invalid");
  }
  if (!report.guarantees || Object.values(report.guarantees).some((value) => value !== false)) {
    errors.push("all non-emission and non-write guarantees must remain false");
  }
  if (!Array.isArray(report.findings) || !Array.isArray(report.boundaries)) {
    errors.push("findings and boundaries must be arrays");
  }
  const forbiddenKey = findForbiddenReportKey(report);
  if (forbiddenKey) errors.push(`forbidden raw-output or identity field: ${forbiddenKey}`);
  const serialized = JSON.stringify(report);
  if (/(?:\/home\/[^/]+\/|\/Users\/[^/]+\/|[A-Za-z]:\\\\Users\\\\[^\\]+\\\\)/.test(serialized)) {
    errors.push("report contains a private absolute path");
  }
  if (/AGE-SECRET-KEY-[A-Z0-9-]+/.test(serialized)) {
    errors.push("report contains an age private identity");
  }
  if (/postgres(?:ql)?:\/\/[^:\s"']+:[^@\s"']+@/i.test(serialized)) {
    errors.push("report contains a credential-bearing URL");
  }
  if (/eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}/.test(serialized)) {
    errors.push("report contains a JWT-shaped value");
  }
  return errors;
}

function renderHuman(report) {
  const toolLine = (name, value) => `${name}: ${value.state}${value.version ? ` (${value.version})` : ""}`;
  const lines = [
    "# SOPS + age Secret Access Adapter",
    "",
    `Status: ${report.status}`,
    `Operation: ${report.operation}`,
    toolLine("SOPS", report.capability.sops),
    toolLine("age", report.capability.age),
    toolLine("age-keygen", report.capability.age_keygen),
    `Identity: ${report.capability.identity.state} (${report.capability.identity.source})`,
  ];
  if (report.encrypted_file) {
    lines.push(`Encrypted file: ${report.encrypted_file.file_name}`);
    lines.push(`Input type: ${report.encrypted_file.input_type || "unknown"}`);
    lines.push(`SOPS encrypted: ${report.encrypted_file.encrypted ? "yes" : "no"}`);
  }
  if (report.execution) {
    lines.push(`Child command: ${report.execution.command_name}`);
    lines.push(`Attempted: ${report.execution.attempted ? "yes" : "no"}`);
    lines.push(`Exit code: ${report.execution.exit_code === null ? "not run" : report.execution.exit_code}`);
    lines.push(`Suppressed output bytes: stdout=${report.execution.stdout_bytes_suppressed}, stderr=${report.execution.stderr_bytes_suppressed}`);
  }
  lines.push("Decrypted values emitted: no");
  lines.push("Private identity emitted: no");
  lines.push("Plaintext files written: no");
  if (report.findings.length) {
    lines.push("Findings:");
    for (const finding of report.findings) lines.push(`- ${finding.severity}: ${finding.code}`);
  }
  lines.push(`Next action: ${report.next_action}`);
  return `${lines.join("\n")}\n`;
}

function statusCode(report) {
  if (report.status === "PASS") return 0;
  if (report.status === "BLOCKED_CAPABILITY" || report.status === "BLOCKED_PERMISSION") return 3;
  return 1;
}

function runInternalChild(payload) {
  let childCommand;
  try {
    childCommand = JSON.parse(Buffer.from(payload || "", "base64url").toString("utf8"));
  } catch {
    return 2;
  }
  if (!Array.isArray(childCommand) || !childCommand.length || childCommand.some((item) => typeof item !== "string")) {
    return 2;
  }
  const result = spawnSync(childCommand[0], childCommand.slice(1), {
    env: process.env,
    stdio: "inherit",
    windowsHide: true,
  });
  if (typeof result.status === "number") return result.status;
  return 1;
}

function main(argv = process.argv.slice(2), env = process.env) {
  if (argv[0] === "__exec-child") return runInternalChild(argv[1]);

  let args;
  try {
    args = parseArgs(argv);
  } catch (error) {
    console.error(error.message);
    console.error("Run with --help for usage.");
    return 2;
  }
  if (args.help) {
    usage();
    return 0;
  }

  let report;
  if (args.operation === "status") report = buildStatusReport(args, env);
  else if (args.operation === "validate-file") report = buildFileReport(args);
  else report = buildRunReport(args, env);

  if (args.validate) {
    const errors = validateReport(report);
    if (errors.length) {
      console.error("SOPS + age adapter report validation failed:");
      for (const error of errors) console.error(`- ${error}`);
      return 1;
    }
  }

  process.stdout.write(args.json ? `${JSON.stringify(report, null, 2)}\n` : renderHuman(report));
  return statusCode(report);
}

if (require.main === module) process.exitCode = main();

