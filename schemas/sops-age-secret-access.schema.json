{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AyobamiH/coding-workflow-library/schemas/sops-age-secret-access.schema.json",
  "title": "SOPS and age secret access adapter report",
  "type": "object",
  "required": [
    "schema_version",
    "provider",
    "operation",
    "status",
    "capability",
    "encrypted_file",
    "execution",
    "guarantees",
    "findings",
    "boundaries",
    "next_action"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "provider": { "const": "sops-age" },
    "operation": {
      "enum": ["status", "validate-file", "run"]
    },
    "status": {
      "enum": ["PASS", "FAIL", "BLOCKED_CAPABILITY", "BLOCKED_PERMISSION"]
    },
    "capability": {
      "type": "object",
      "required": ["sops", "age", "age_keygen", "identity"],
      "properties": {
        "sops": { "$ref": "#/definitions/tool" },
        "age": { "$ref": "#/definitions/tool" },
        "age_keygen": { "$ref": "#/definitions/tool" },
        "identity": {
          "type": "object",
          "required": ["state", "source", "private_permissions"],
          "properties": {
            "state": {
              "enum": ["NOT_CHECKED", "AVAILABLE", "NOT_CONFIGURED", "UNSAFE"]
            },
            "source": {
              "enum": [
                "none",
                "explicit_file",
                "environment_file",
                "inline_environment",
                "default_file"
              ]
            },
            "private_permissions": {
              "type": ["boolean", "null"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "encrypted_file": {
      "type": ["object", "null"],
      "properties": {
        "file_name": { "type": "string", "minLength": 1 },
        "input_type": {
          "type": ["string", "null"],
          "enum": ["dotenv", "ini", "json", "yaml", null]
        },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "encrypted": { "type": "boolean" },
        "valid": { "type": "boolean" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/definitions/finding" }
        }
      },
      "required": [
        "file_name",
        "input_type",
        "size_bytes",
        "encrypted",
        "valid",
        "findings"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": ["object", "null"],
      "properties": {
        "attempted": { "type": "boolean" },
        "dry_run": { "type": "boolean" },
        "command_name": { "type": "string" },
        "exit_code": { "type": ["integer", "null"] },
        "signal": { "type": ["string", "null"] },
        "stdout_bytes_suppressed": { "type": "integer", "minimum": 0 },
        "stderr_bytes_suppressed": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "attempted",
        "dry_run",
        "command_name",
        "exit_code",
        "signal",
        "stdout_bytes_suppressed",
        "stderr_bytes_suppressed"
      ],
      "additionalProperties": false
    },
    "guarantees": {
      "type": "object",
      "required": [
        "decrypted_values_emitted",
        "provider_output_emitted",
        "private_identity_emitted",
        "plaintext_files_written",
        "repository_files_written"
      ],
      "properties": {
        "decrypted_values_emitted": { "const": false },
        "provider_output_emitted": { "const": false },
        "private_identity_emitted": { "const": false },
        "plaintext_files_written": { "const": false },
        "repository_files_written": { "const": false }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/finding" }
    },
    "boundaries": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "next_action": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "tool": {
      "type": "object",
      "required": ["state", "version"],
      "properties": {
        "state": {
          "enum": ["NOT_CHECKED", "AVAILABLE", "MISSING", "UNAVAILABLE"]
        },
        "version": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["code", "severity"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "severity": { "enum": ["error", "blocker", "warning"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
