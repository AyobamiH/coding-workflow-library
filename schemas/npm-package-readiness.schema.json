{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coding-workflow/npm-package-readiness.schema.json",
  "title": "NPM Package Readiness Report",
  "type": "object",
  "required": [
    "schema_version",
    "repo",
    "expectations",
    "pack_dry_run",
    "checks",
    "blockers",
    "warnings",
    "not_verified",
    "release_boundaries",
    "final_status",
    "next_safe_step"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "repo": {
      "type": "object",
      "required": ["root"],
      "properties": { "root": { "const": "." } },
      "additionalProperties": false
    },
    "expectations": {
      "type": "object",
      "required": ["package", "cli", "pack_dry_run"],
      "properties": {
        "package": { "type": "boolean" },
        "cli": { "type": "boolean" },
        "pack_dry_run": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "pack_dry_run": {
      "type": "object",
      "required": ["status", "entry_count", "risks", "evidence"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "entry_count": { "type": "integer", "minimum": 0 },
        "risks": { "type": "array" },
        "evidence": { "type": "string" }
      }
    },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "blockers": { "type": "array" },
    "warnings": { "type": "array" },
    "not_verified": { "type": "array" },
    "release_boundaries": { "type": "array", "items": { "type": "string" } },
    "final_status": { "$ref": "#/$defs/status" },
    "next_safe_step": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "status": {
      "enum": ["PASS", "WARN", "FAIL", "NOT_VERIFIED", "NOT_APPLICABLE"]
    },
    "check": {
      "type": "object",
      "required": ["code", "status", "label", "evidence", "next_safe_step"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "label": { "type": "string" },
        "evidence": { "type": "string" },
        "next_safe_step": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
