{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AyobamiH/coding-workflow-library/schemas/secret-bundles.schema.json",
  "title": "Purpose-scoped encrypted secret bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "tooling", "bundles", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_names"],
      "properties": {
        "description": { "type": "string" },
        "expected_names": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        }
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sops_bin", "age_bin", "age_keygen_bin", "age_key_file", "policy_file"],
      "properties": {
        "sops_bin": { "type": "string", "minLength": 1 },
        "age_bin": { "type": "string", "minLength": 1 },
        "age_keygen_bin": { "type": "string", "minLength": 1 },
        "age_key_file": { "type": "string", "minLength": 1 },
        "policy_file": { "type": "string", "minLength": 1 }
      }
    },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bundle" }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "runtime"],
      "properties": {
        "source": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "runtime": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "variables", "consumers"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "file": { "type": "string", "pattern": "^[^/]+\\.enc\\.json$" },
        "description": { "type": "string" },
        "consumers": { "type": "array", "items": { "type": "string" } },
        "variables": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/variable" } }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bundle", "allowed_commands"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "bundle": { "$ref": "#/$defs/id" },
        "description": { "type": "string" },
        "openclaw_resolver": { "type": "boolean" },
        "allowed_commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^/\\\\]+$" }
        }
      }
    }
  }
}
