{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AyobamiH/coding-workflow-library/schemas/multi-project-proof.schema.json",
  "title": "Multi-Project Workflow Proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "contract",
    "repositories_required",
    "repositories_observed",
    "results",
    "failures",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["PASS", "FAIL"] },
    "contract": { "const": "bounded-read-only-workflow-v1" },
    "repositories_required": { "type": "integer", "minimum": 3 },
    "repositories_observed": { "type": "integer", "minimum": 0 },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "status", "git", "lane_state_unchanged", "contracts", "failures"],
        "properties": {
          "label": { "type": "string" },
          "status": { "enum": ["PASS", "FAIL"] },
          "git": { "type": "object" },
          "lane_state_unchanged": { "type": "boolean" },
          "contracts": { "type": "array" },
          "failures": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "failures": { "type": "array", "items": { "type": "string" } },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
