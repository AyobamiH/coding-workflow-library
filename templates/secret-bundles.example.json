{
  "$schema": "../schemas/secret-bundles.schema.json",
  "schema_version": 1,
  "source": {
    "description": "One-time plaintext source to retire after complete encrypted delivery proof.",
    "expected_names": [
      "EXAMPLE_SERVICE_TOKEN",
      "EXAMPLE_PUBLIC_ID"
    ]
  },
  "tooling": {
    "sops_bin": "<SOPS_BINARY>",
    "age_bin": "<AGE_BINARY>",
    "age_keygen_bin": "<AGE_KEYGEN_BINARY>",
    "age_key_file": "<PRIVATE_AGE_IDENTITY>",
    "policy_file": "<PRIVATE_SOPS_POLICY>"
  },
  "bundles": [
    {
      "id": "example-service",
      "file": "example-service.enc.json",
      "description": "Credentials required by one service boundary.",
      "consumers": ["example-cli", "example-worker"],
      "variables": [
        { "source": "EXAMPLE_SERVICE_TOKEN", "runtime": "SERVICE_TOKEN" },
        { "source": "EXAMPLE_PUBLIC_ID", "runtime": "PUBLIC_ID" }
      ]
    }
  ],
  "profiles": [
    {
      "id": "example-read",
      "bundle": "example-service",
      "description": "Read-only service inspection.",
      "allowed_commands": ["example-cli", "node"]
    }
  ]
}
